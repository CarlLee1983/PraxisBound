{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:cli-result:1",
  "title": "PraxisBound CLI Result Envelope v1",
  "description": "The canonical JSON envelope emitted by PraxisBound CLI 0.1.x commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "status",
    "outcome",
    "exit",
    "subject",
    "issues"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "0.10.0" },
    "status": { "enum": ["pass", "fail", "warning", "error"] },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "warning",
        "usage-error",
        "configuration-error",
        "internal-error",
        "RELEASE_READY",
        "RELEASE_INCOMPLETE",
        "INIT_APPLIED",
        "INIT_PREVIEW",
        "INIT_CONFLICT",
        "INIT_OPERATION_REFUSED",
        "INIT_APPLY_FAILED_RECOVERED",
        "INIT_RECOVERY_INCOMPLETE",
        "INIT_CLEANUP_INCOMPLETE",
        "ACTIVATION_PREVIEW",
        "ACTIVATION_APPLIED",
        "ACTIVATION_UNCHANGED",
        "ACTIVATION_CONFLICT",
        "ACTIVATION_OPERATION_REFUSED",
        "ACTIVATION_APPLY_FAILED_RECOVERED",
        "ACTIVATION_RECOVERY_INCOMPLETE",
        "ACTIVATION_CLEANUP_INCOMPLETE",
        "REVIEW_READY",
        "REVIEW_BLOCKED",
        "REVIEW_INCOMPLETE",
        "REVIEW_STALE",
        "ERROR"
      ]
    },
    "exit": { "enum": [0, 1, 2, 3] },
    "subject": { "$ref": "#/$defs/subject" },
    "path": { "$ref": "#/$defs/repositoryPath" },
    "data": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "error": { "$ref": "#/$defs/error" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "pass" },
        "outcome": {
          "enum": [
            "success",
            "RELEASE_READY",
            "INIT_APPLIED",
            "INIT_PREVIEW",
            "ACTIVATION_PREVIEW",
            "ACTIVATION_APPLIED",
            "ACTIVATION_UNCHANGED",
            "REVIEW_READY"
          ]
        },
        "exit": { "const": 0 }
      }
    },
    {
      "properties": {
        "status": { "const": "fail" },
        "outcome": {
          "enum": [
            "failure",
            "RELEASE_INCOMPLETE",
            "INIT_CONFLICT",
            "INIT_OPERATION_REFUSED",
            "INIT_APPLY_FAILED_RECOVERED",
            "INIT_RECOVERY_INCOMPLETE",
            "INIT_CLEANUP_INCOMPLETE",
            "ACTIVATION_CONFLICT",
            "ACTIVATION_OPERATION_REFUSED",
            "ACTIVATION_APPLY_FAILED_RECOVERED",
            "ACTIVATION_RECOVERY_INCOMPLETE",
            "ACTIVATION_CLEANUP_INCOMPLETE",
            "REVIEW_BLOCKED",
            "REVIEW_INCOMPLETE",
            "REVIEW_STALE"
          ]
        },
        "exit": { "const": 1 }
      }
    },
    {
      "properties": {
        "status": { "const": "warning" },
        "outcome": { "const": "warning" },
        "exit": { "const": 0 }
      }
    },
    {
      "properties": {
        "status": { "const": "error" },
        "outcome": {
          "enum": ["usage-error", "configuration-error", "internal-error"]
        },
        "exit": { "const": 2 }
      }
    },
    {
      "properties": {
        "status": { "const": "error" },
        "outcome": { "const": "ERROR" },
        "exit": { "enum": [2, 3] }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[A-Za-z0-9][A-Za-z0-9._-]*)?$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]+$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]+$"
        },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "subject": { "$ref": "#/$defs/subject" }
      }
    }
  }
}
