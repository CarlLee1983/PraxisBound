#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [story-directory ...]\n' "$0" >&2
  printf '       %s --result [story-directory ...]\n' "$0" >&2
  printf '       %s --help\n' "$0" >&2
}

usage_error() {
  printf 'ERROR Invalid arguments\n' >&2
  usage
  printf '\nResult: ERROR\n'
  printf 'Stories checked: 0\n'
}

help() {
  printf 'PraxisBound Verification Check\n\n'
  printf 'Usage: %s [story-directory ...]\n' "$0"
  printf '       %s --result [story-directory ...]\n' "$0"
  printf '       %s --help\n\n' "$0"
  printf 'Without arguments, every directory under specs/stories/ except\n'
  printf '_template/ is checked relative to the current directory.\n\n'
  printf 'The default mode resolves the task mode, authority, risk level,\n'
  printf 'architecture impact, and the required verification profile a Story\n'
  printf 'declares, applying the documented defaults for an older Story.\n'
  printf '%s\n' '--result also reads verification.md and reports PASS, PARTIAL, or FAIL.'
  printf 'The check is static and read-only. It never executes a verification\n'
  printf 'command, never re-runs a recorded check, and never replaces make\n'
  printf 'verify or human review.\n'
}

praxisbound_trim() {
  praxisbound_trimmed=$1

  while :; do
    case "$praxisbound_trimmed" in
      *"$praxisbound_cr") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_cr"} ;;
      *"$praxisbound_tab") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_tab"} ;;
      *' ') praxisbound_trimmed=${praxisbound_trimmed% } ;;
      *) break ;;
    esac
  done

  while :; do
    case "$praxisbound_trimmed" in
      "$praxisbound_cr"*) praxisbound_trimmed=${praxisbound_trimmed#"$praxisbound_cr"} ;;
      "$praxisbound_tab"*) praxisbound_trimmed=${praxisbound_trimmed#"$praxisbound_tab"} ;;
      ' '*) praxisbound_trimmed=${praxisbound_trimmed# } ;;
      *) break ;;
    esac
  done
}

# The documented Markdown fence subset, kept identical to scripts/story-check so
# a fenced example is documentation in every PraxisBound contract reader.
praxisbound_update_fence() {
  praxisbound_fence_line=$1
  praxisbound_fence_changed=0

  if [ "$praxisbound_fence_length" -eq 0 ]; then
    case "$praxisbound_fence_line" in
      '`'*) praxisbound_fence_character='`' ;;
      '~'*) praxisbound_fence_character='~' ;;
      *) return ;;
    esac

    praxisbound_fence_rest=$praxisbound_fence_line
    praxisbound_fence_run=0
    while :; do
      case "$praxisbound_fence_rest" in
        "$praxisbound_fence_character"*)
          praxisbound_fence_rest=${praxisbound_fence_rest#"$praxisbound_fence_character"}
          praxisbound_fence_run=$((praxisbound_fence_run + 1))
          ;;
        *) break ;;
      esac
    done

    if [ "$praxisbound_fence_run" -ge 3 ]; then
      praxisbound_fence_length=$praxisbound_fence_run
      praxisbound_fence_changed=1
    fi
    return
  fi

  case "$praxisbound_fence_line" in
    "$praxisbound_fence_character"*) ;;
    *) return ;;
  esac

  praxisbound_fence_rest=$praxisbound_fence_line
  praxisbound_fence_run=0
  while :; do
    case "$praxisbound_fence_rest" in
      "$praxisbound_fence_character"*)
        praxisbound_fence_rest=${praxisbound_fence_rest#"$praxisbound_fence_character"}
        praxisbound_fence_run=$((praxisbound_fence_run + 1))
        ;;
      *) break ;;
    esac
  done

  if [ "$praxisbound_fence_run" -ge "$praxisbound_fence_length" ] &&
    [ -z "$praxisbound_fence_rest" ]; then
    praxisbound_fence_length=0
    praxisbound_fence_changed=1
  fi
}

praxisbound_is_exact_literal() {
  praxisbound_exact_literal=$1
  praxisbound_trim "$praxisbound_exact_literal"
  praxisbound_exact_literal=$praxisbound_trimmed

  case "$praxisbound_exact_literal" in
    \`*\`) ;;
    *) return 1 ;;
  esac

  praxisbound_exact_literal=${praxisbound_exact_literal#\`}
  praxisbound_exact_literal=${praxisbound_exact_literal%\`}

  case "$praxisbound_exact_literal" in
    ''|*'`'*) return 1 ;;
    *[![:space:]]*) ;;
    *) return 1 ;;
  esac

  case "$praxisbound_exact_literal" in
    '*'|'-'|TBD|tbd|TODO|todo|'N/A'|'n/a'|'...') return 1 ;;
  esac

  return 0
}

praxisbound_unquote() {
  praxisbound_unquoted=$1
  praxisbound_trim "$praxisbound_unquoted"
  praxisbound_unquoted=$praxisbound_trimmed
  praxisbound_unquoted=${praxisbound_unquoted#\`}
  praxisbound_unquoted=${praxisbound_unquoted%\`}
}

# Walks the "* label: value" bullets of one Markdown section and hands each one
# to a callback. The reader owns fences and heading scope; the callback owns
# meaning, so every section below shares exactly one parsing subset.
praxisbound_scan_section() {
  praxisbound_scan_file=$1
  praxisbound_scan_heading=$2
  praxisbound_scan_callback=$3
  praxisbound_section_count=0
  praxisbound_scan_in=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_scan_line || [ -n "$praxisbound_scan_line" ]; do
    praxisbound_trim "$praxisbound_scan_line"
    praxisbound_scan_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_scan_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_scan_line" in
      '#'*)
        if [ "$praxisbound_scan_line" = "$praxisbound_scan_heading" ]; then
          praxisbound_section_count=$((praxisbound_section_count + 1))
          praxisbound_scan_in=1
        else
          praxisbound_scan_in=0
        fi
        continue
        ;;
    esac

    [ "$praxisbound_scan_in" -eq 1 ] || continue

    case "$praxisbound_scan_line" in
      '- '*) praxisbound_scan_line="* ${praxisbound_scan_line#'- '}" ;;
    esac

    case "$praxisbound_scan_line" in
      '* '*) ;;
      *) continue ;;
    esac

    praxisbound_scan_bullet=${praxisbound_scan_line#'* '}
    praxisbound_trim "$praxisbound_scan_bullet"
    praxisbound_scan_bullet=$praxisbound_trimmed
    [ -n "$praxisbound_scan_bullet" ] || continue

    "$praxisbound_scan_callback" "$praxisbound_scan_bullet"
  done <"$praxisbound_scan_file"
}

praxisbound_split_bullet() {
  praxisbound_bullet_label=
  praxisbound_bullet_value=

  case "$1" in
    *': '*)
      praxisbound_bullet_label=${1%%': '*}
      praxisbound_bullet_value=${1#*': '}
      ;;
    *':')
      praxisbound_bullet_label=${1%':'}
      ;;
    *) return 1 ;;
  esac

  praxisbound_trim "$praxisbound_bullet_label"
  praxisbound_bullet_label=$praxisbound_trimmed
  praxisbound_trim "$praxisbound_bullet_value"
  praxisbound_bullet_value=$praxisbound_trimmed
  [ -n "$praxisbound_bullet_label" ]
}

praxisbound_report() {
  printf '%s  %s: %s\n' "$1" "$praxisbound_story_label" "$2"
}

praxisbound_plan_fail() {
  praxisbound_report 'FAIL' "plan: $1"
  praxisbound_plan_incomplete=$((praxisbound_plan_incomplete + 1))
}

praxisbound_record_fail() {
  praxisbound_report 'FAIL' "result: $1"
  praxisbound_record_incomplete=$((praxisbound_record_incomplete + 1))
}

# --- Story declarations -----------------------------------------------------

praxisbound_classification_bullet() {
  praxisbound_split_bullet "$1" || return 0

  if [ "$praxisbound_bullet_label" = 'Task mode' ]; then
    praxisbound_task_mode_count=$((praxisbound_task_mode_count + 1))
    praxisbound_task_mode=$praxisbound_bullet_value
  fi
}

praxisbound_authority_bullet() {
  praxisbound_split_bullet "$1" || {
    praxisbound_plan_fail "authority entry is not a declaration: $1"
    return 0
  }

  case " $praxisbound_authority_keys " in
    *" $praxisbound_bullet_label "*) ;;
    *)
      praxisbound_plan_fail "authority declares an unknown operation: $praxisbound_bullet_label"
      return 0
      ;;
  esac

  case " $praxisbound_authority_seen " in
    *" $praxisbound_bullet_label "*)
      praxisbound_plan_fail "authority declares $praxisbound_bullet_label more than once"
      return 0
      ;;
  esac
  praxisbound_authority_seen="$praxisbound_authority_seen $praxisbound_bullet_label"

  case "$praxisbound_bullet_value" in
    yes|no) ;;
    *)
      praxisbound_plan_fail "authority $praxisbound_bullet_label must be declared as yes or no"
      return 0
      ;;
  esac

  eval "praxisbound_authority_$praxisbound_bullet_label=\$praxisbound_bullet_value"
}

praxisbound_architecture_bullet() {
  praxisbound_split_bullet "$1" || {
    praxisbound_plan_fail "architecture entry is not a declaration: $1"
    return 0
  }

  case "$praxisbound_bullet_label" in
    Impact)
      praxisbound_impact_count=$((praxisbound_impact_count + 1))
      praxisbound_impact=$praxisbound_bullet_value
      ;;
    # This checker validates the shape of each declaration and nothing more.
    # Resolving a decision to a record, and an owner to a declared boundary, is
    # scripts/story-check's job; ADR-003 records that PraxisBound analyses no
    # further than this.
    Decision)
      praxisbound_is_exact_literal "$praxisbound_bullet_value" ||
        praxisbound_plan_fail 'architecture decision must name one exact backticked decision ID'
      ;;
    Boundary)
      praxisbound_is_exact_literal "$praxisbound_bullet_value" ||
        praxisbound_plan_fail 'architecture boundary must name one exact backticked boundary'
      ;;
    Contract)
      praxisbound_is_exact_literal "$praxisbound_bullet_value" ||
        praxisbound_plan_fail 'architecture contract must state one exact backticked contract'
      ;;
    Owner)
      praxisbound_is_exact_literal "$praxisbound_bullet_value" ||
        praxisbound_plan_fail 'architecture owner must state one exact backticked `<boundary> = <owner>`'
      ;;
    *)
      praxisbound_plan_fail "architecture declares an unknown label: $praxisbound_bullet_label"
      ;;
  esac
}

praxisbound_risk_bullet() {
  praxisbound_split_bullet "$1" || {
    praxisbound_plan_fail "risk entry is not a declaration: $1"
    return 0
  }

  case "$praxisbound_bullet_label" in
    Level)
      praxisbound_risk_level_count=$((praxisbound_risk_level_count + 1))
      praxisbound_risk_level=$praxisbound_bullet_value
      ;;
    Reason)
      praxisbound_reason_count=$((praxisbound_reason_count + 1))
      if praxisbound_is_exact_literal "$praxisbound_bullet_value"; then
        praxisbound_unquote "$praxisbound_bullet_value"
        praxisbound_reasons="$praxisbound_reasons$praxisbound_unquoted "
      else
        praxisbound_plan_fail 'risk reason must name one same-line backticked signal'
      fi
      ;;
    Signal)
      if praxisbound_is_exact_literal "$praxisbound_bullet_value"; then
        praxisbound_unquote "$praxisbound_bullet_value"
        case "$praxisbound_unquoted" in
          error-projection|concurrency|bounded-capacity|retention-overflow) ;;
          *)
            praxisbound_plan_fail "risk signal is unknown: $praxisbound_unquoted"
            return 0
            ;;
        esac

        case " $praxisbound_risk_signals " in
          *" $praxisbound_unquoted "*)
            praxisbound_plan_fail "risk signal declared more than once: $praxisbound_unquoted"
            ;;
          *) praxisbound_risk_signals="$praxisbound_risk_signals$praxisbound_unquoted " ;;
        esac
      else
        praxisbound_plan_fail 'risk signal must name one same-line backticked signal'
      fi
      ;;
    *)
      praxisbound_plan_fail "risk declares an unknown label: $praxisbound_bullet_label"
      ;;
  esac
}

praxisbound_scope_bullet() {
  praxisbound_split_bullet "$1" || {
    praxisbound_plan_fail "verification scope entry is not a declaration: $1"
    return 0
  }

  case "$praxisbound_bullet_label" in
    Scope)
      praxisbound_scope_count=$((praxisbound_scope_count + 1))
      praxisbound_scope=$praxisbound_bullet_value
      ;;
    Surface)
      praxisbound_surface_count=$((praxisbound_surface_count + 1))
      praxisbound_surface=$praxisbound_bullet_value
      ;;
    *)
      case " $praxisbound_check_layers " in
        *" $praxisbound_bullet_label "*) ;;
        *)
          praxisbound_plan_fail "verification scope declares an unknown check: $praxisbound_bullet_label"
          return 0
          ;;
      esac
      case " $praxisbound_scope_seen " in
        *" $praxisbound_bullet_label "*)
          praxisbound_plan_fail "verification scope declares $praxisbound_bullet_label more than once"
          return 0
          ;;
      esac
      praxisbound_scope_seen="$praxisbound_scope_seen $praxisbound_bullet_label"
      if ! praxisbound_is_exact_literal "$praxisbound_bullet_value"; then
        praxisbound_plan_fail "verification scope $praxisbound_bullet_label must name one exact backticked command"
        return 0
      fi
      praxisbound_scope_commands="$praxisbound_scope_commands$praxisbound_unit_separator$praxisbound_bullet_label=$praxisbound_bullet_value$praxisbound_unit_separator"
      ;;
  esac
}

praxisbound_resolve_story() {
  praxisbound_task_mode=execution
  praxisbound_task_mode_count=0
  praxisbound_impact=low
  praxisbound_impact_count=0
  praxisbound_risk_level=low
  praxisbound_risk_level_count=0

  praxisbound_reasons=
  praxisbound_reason_count=0
  praxisbound_risk_signals=
  praxisbound_authority_seen=
  praxisbound_scope=full
  praxisbound_scope_count=0
  praxisbound_surface=
  praxisbound_surface_count=0
  praxisbound_scope_seen=' '
  praxisbound_scope_commands=

  praxisbound_scan_section "$praxisbound_story_file" '## Classification' \
    praxisbound_classification_bullet

  if [ "$praxisbound_task_mode_count" -gt 1 ]; then
    praxisbound_plan_fail 'Classification must declare "Task mode" at most once'
    praxisbound_task_mode=execution
  fi

  case "$praxisbound_task_mode" in
    architecture|execution|evidence|mixed) ;;
    *)
      praxisbound_plan_fail 'Task mode must be architecture, execution, evidence, or mixed'
      praxisbound_task_mode=execution
      ;;
  esac

  # Least privilege by task mode. An older Story that declares no authority at
  # all keeps the historical implementation permission, because entering
  # implementation is what an approved execution Story already authorized. It
  # never inherits commit, push, deploy, dependency, or migration authority.
  praxisbound_authority_plan=yes
  praxisbound_authority_add_dependency=no
  praxisbound_authority_migration=no
  praxisbound_authority_commit=no
  praxisbound_authority_push=no
  praxisbound_authority_deploy=no
  case "$praxisbound_task_mode" in
    execution|mixed) praxisbound_authority_modify=yes ;;
    *) praxisbound_authority_modify=no ;;
  esac

  praxisbound_scan_section "$praxisbound_story_file" '## Authority' \
    praxisbound_authority_bullet
  praxisbound_authority_declared=$praxisbound_section_count

  if [ "$praxisbound_authority_declared" -gt 1 ]; then
    praxisbound_plan_fail 'Story must declare ## Authority at most once'
  fi

  praxisbound_scan_section "$praxisbound_story_file" '## Architecture' \
    praxisbound_architecture_bullet
  praxisbound_architecture_declared=$praxisbound_section_count

  if [ "$praxisbound_architecture_declared" -gt 1 ]; then
    praxisbound_plan_fail 'Story must declare ## Architecture at most once'
  fi

  if [ "$praxisbound_impact_count" -gt 1 ]; then
    praxisbound_plan_fail 'Architecture must declare "Impact" at most once'
    praxisbound_impact=low
  fi

  case "$praxisbound_impact" in
    low|medium|high) ;;
    *)
      praxisbound_plan_fail 'Architecture impact must be low, medium, or high'
      praxisbound_impact=low
      ;;
  esac

  praxisbound_scan_section "$praxisbound_story_file" '## Risk' praxisbound_risk_bullet
  praxisbound_risk_declared=$praxisbound_section_count

  if [ "$praxisbound_risk_declared" -gt 1 ]; then
    praxisbound_plan_fail 'Story must declare ## Risk at most once'
  fi

  if [ "$praxisbound_risk_level_count" -gt 1 ]; then
    praxisbound_plan_fail 'Risk must declare "Level" at most once'
    praxisbound_risk_level=low
  fi

  case "$praxisbound_risk_level" in
    low|medium|high) ;;
    *)
      praxisbound_plan_fail 'Risk level must be low, medium, or high'
      praxisbound_risk_level=low
      ;;
  esac

  case "$praxisbound_risk_level" in
    low) praxisbound_required_checks='lint static unit' ;;
    medium) praxisbound_required_checks='lint static unit integration' ;;
    high) praxisbound_required_checks='lint static unit integration contract e2e' ;;
  esac

  case "$praxisbound_impact" in
    medium|high)
      praxisbound_required_checks="$praxisbound_required_checks architecture"
      ;;
  esac

  praxisbound_scan_section "$praxisbound_story_file" '## Verification Scope' \
    praxisbound_scope_bullet
  praxisbound_scope_declared=$praxisbound_section_count
  if [ "$praxisbound_section_count" -gt 1 ] ||
    { [ "$praxisbound_section_count" -eq 1 ] && [ "$praxisbound_scope_count" -ne 1 ]; }; then
    praxisbound_plan_fail 'Story must declare one Scope in at most one ## Verification Scope section'
  fi
  if [ "$praxisbound_scope_count" -gt 1 ]; then
    praxisbound_plan_fail 'verification Scope is declared more than once'
  fi
  if [ "$praxisbound_surface_count" -gt 1 ]; then
    praxisbound_plan_fail 'verification Surface is declared more than once'
  fi
  case "$praxisbound_scope" in
    full)
      if [ "$praxisbound_surface_count" -ne 0 ] || [ -n "$praxisbound_scope_commands" ]; then
        praxisbound_plan_fail 'full verification scope must not declare Surface or focused commands'
      fi
      if [ "$praxisbound_scope_count" -eq 1 ]; then
        praxisbound_required_checks="$praxisbound_required_checks full"
      fi
      ;;
    focused)
      if [ "$praxisbound_surface_count" -ne 1 ]; then
        praxisbound_plan_fail 'focused verification scope must declare one Surface'
      fi
      case "$praxisbound_surface" in
        executable) ;;
        documentation)
          if [ "$praxisbound_risk_level" != low ] || [ "$praxisbound_impact" != low ]; then
            praxisbound_plan_fail 'focused documentation requires low risk and low architecture impact'
          fi
          praxisbound_required_checks=documentation
          ;;
        *) praxisbound_plan_fail 'focused verification Surface must be executable or documentation' ;;
      esac
      for praxisbound_scope_check in $praxisbound_required_checks; do
        case " $praxisbound_scope_seen " in
          *" $praxisbound_scope_check "*) ;;
          *) praxisbound_plan_fail "focused verification check is not declared: $praxisbound_scope_check" ;;
        esac
      done
      for praxisbound_scope_check in $praxisbound_scope_seen; do
        case " $praxisbound_required_checks " in
          *" $praxisbound_scope_check "*) ;;
          *) praxisbound_plan_fail "focused verification declares an unrequired check: $praxisbound_scope_check" ;;
        esac
      done
      ;;
    *) praxisbound_plan_fail 'verification Scope must be full or focused' ;;
  esac
}

praxisbound_print_plan() {
  printf '\n%s:\n' "$praxisbound_story_label"
  printf '  Task mode: %s\n' "$praxisbound_task_mode"
  printf '  Authority: plan=%s modify=%s add_dependency=%s migration=%s commit=%s push=%s deploy=%s\n' \
    "$praxisbound_authority_plan" "$praxisbound_authority_modify" \
    "$praxisbound_authority_add_dependency" "$praxisbound_authority_migration" \
    "$praxisbound_authority_commit" "$praxisbound_authority_push" \
    "$praxisbound_authority_deploy"
  printf '  Risk level: %s\n' "$praxisbound_risk_level"
  printf '  Architecture impact: %s\n' "$praxisbound_impact"
  if [ "$praxisbound_scope_declared" -gt 0 ]; then
    printf '  Verification scope: %s%s\n' "$praxisbound_scope" "${praxisbound_surface:+ $praxisbound_surface}"
  fi
  printf '  Required checks: %s\n' "$praxisbound_required_checks"
}

# --- Acceptance criteria ----------------------------------------------------

praxisbound_read_acceptance_ids() {
  praxisbound_ac_ids=' '
  praxisbound_ac_count=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_ac_line || [ -n "$praxisbound_ac_line" ]; do
    praxisbound_trim "$praxisbound_ac_line"
    praxisbound_ac_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_ac_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_ac_line" in
      '* '*|'- '*) praxisbound_ac_line=${praxisbound_ac_line#??} ;;
      *) continue ;;
    esac

    case "$praxisbound_ac_line" in
      '[ ] '*|'[x] '*|'[X] '*) praxisbound_ac_line=${praxisbound_ac_line#????} ;;
      *) continue ;;
    esac

    case "$praxisbound_ac_line" in
      AC-*:*) ;;
      *) continue ;;
    esac

    praxisbound_ac_id=${praxisbound_ac_line%%:*}
    case "${praxisbound_ac_id#AC-}" in
      ''|*[!0-9]*) continue ;;
    esac

    case "$praxisbound_ac_ids" in
      *" $praxisbound_ac_id "*) continue ;;
    esac

    praxisbound_ac_ids="$praxisbound_ac_ids$praxisbound_ac_id "
    praxisbound_ac_count=$((praxisbound_ac_count + 1))
  done <"$praxisbound_acceptance_file"
}

# --- Verification result record ---------------------------------------------

praxisbound_check_bullet() {
  praxisbound_split_bullet "$1" || {
    praxisbound_record_fail "check entry is not a declaration: $1"
    return 0
  }

  praxisbound_check_name=$praxisbound_bullet_label
  praxisbound_check_rest=$praxisbound_bullet_value

  case " $praxisbound_check_layers " in
    *" $praxisbound_check_name "*) ;;
    *)
      praxisbound_record_fail "unknown verification check: $praxisbound_check_name"
      return 0
      ;;
  esac

  case " $praxisbound_checks_seen " in
    *" $praxisbound_check_name "*)
      praxisbound_record_fail "verification check is recorded more than once: $praxisbound_check_name"
      return 0
      ;;
  esac
  praxisbound_checks_seen="$praxisbound_checks_seen $praxisbound_check_name"

  case "$praxisbound_check_rest" in
    *' — '*)
      praxisbound_check_status=${praxisbound_check_rest%%' — '*}
      praxisbound_check_detail=${praxisbound_check_rest#*' — '}
      ;;
    *)
      praxisbound_check_status=$praxisbound_check_rest
      praxisbound_check_detail=
      ;;
  esac

  praxisbound_trim "$praxisbound_check_status"
  praxisbound_check_status=$praxisbound_trimmed

  case "$praxisbound_check_status" in
    pass|fail|skipped|blocked|unsupported) ;;
    *)
      praxisbound_record_fail "check $praxisbound_check_name status must be pass, fail, skipped, blocked, or unsupported"
      return 0
      ;;
  esac

  praxisbound_is_exact_literal "$praxisbound_check_detail" ||
    praxisbound_record_fail "check $praxisbound_check_name must name one exact backticked command or reason"

  if [ "$praxisbound_check_name" = full ] && [ "$praxisbound_check_status" = pass ] &&
    [ "$praxisbound_check_detail" != '`make verify`' ]; then
    praxisbound_record_fail 'full check PASS must name `make verify`'
  fi

  if [ "$praxisbound_scope" = focused ] && [ "$praxisbound_check_status" = pass ] &&
    [ "$praxisbound_check_name" != full ]; then
    case "$praxisbound_scope_commands" in
      *"$praxisbound_unit_separator$praxisbound_check_name=$praxisbound_check_detail$praxisbound_unit_separator"*) ;;
      *) praxisbound_record_fail "check $praxisbound_check_name does not match its declared focused command" ;;
    esac
  fi

  praxisbound_check_report="$praxisbound_check_report$praxisbound_check_name=$praxisbound_check_status "

  case "$praxisbound_check_status" in
    fail) praxisbound_result_failed=$((praxisbound_result_failed + 1)) ;;
  esac
}

praxisbound_evidence_bullet() {
  praxisbound_split_bullet "$1" || {
    praxisbound_record_fail "evidence entry is not a declaration: $1"
    return 0
  }

  if ! praxisbound_is_exact_literal "$praxisbound_bullet_label"; then
    praxisbound_record_fail "evidence entry must name one exact backticked AC ID: $praxisbound_bullet_label"
    return 0
  fi

  praxisbound_unquote "$praxisbound_bullet_label"
  praxisbound_evidence_ac=$praxisbound_unquoted

  case "$praxisbound_ac_ids" in
    *" $praxisbound_evidence_ac "*) ;;
    *)
      praxisbound_record_fail "evidence names unknown AC ID: $praxisbound_evidence_ac"
      return 0
      ;;
  esac

  case " $praxisbound_evidence_seen " in
    *" $praxisbound_evidence_ac "*)
      praxisbound_record_fail "evidence duplicates AC ID: $praxisbound_evidence_ac"
      return 0
      ;;
  esac
  praxisbound_evidence_seen="$praxisbound_evidence_seen $praxisbound_evidence_ac"
  praxisbound_evidence_traced=$((praxisbound_evidence_traced + 1))

  case "$praxisbound_bullet_value" in
    *' — '*)
      praxisbound_evidence_status=${praxisbound_bullet_value%%' — '*}
      praxisbound_evidence_detail=${praxisbound_bullet_value#*' — '}
      ;;
    *)
      praxisbound_evidence_status=$praxisbound_bullet_value
      praxisbound_evidence_detail=
      ;;
  esac

  praxisbound_trim "$praxisbound_evidence_status"
  praxisbound_evidence_status=$praxisbound_trimmed

  case "$praxisbound_evidence_status" in
    pass|fail|blocked|skipped) ;;
    *)
      praxisbound_record_fail "evidence $praxisbound_evidence_ac status must be pass, fail, blocked, or skipped"
      return 0
      ;;
  esac

  praxisbound_is_exact_literal "$praxisbound_evidence_detail" ||
    praxisbound_record_fail "evidence $praxisbound_evidence_ac must name one exact backticked observation"

  case "$praxisbound_evidence_status" in
    pass) praxisbound_evidence_passed="$praxisbound_evidence_passed$praxisbound_evidence_ac " ;;
    fail) praxisbound_result_failed=$((praxisbound_result_failed + 1)) ;;
  esac
}

praxisbound_authority_used_bullet() {
  praxisbound_trim "$1"
  praxisbound_used=$praxisbound_trimmed

  case " $praxisbound_authority_keys " in
    *" $praxisbound_used "*) ;;
    *)
      praxisbound_record_fail "authority used names an unknown operation: $praxisbound_used"
      return 0
      ;;
  esac

  eval "praxisbound_granted=\$praxisbound_authority_$praxisbound_used"

  if [ "$praxisbound_granted" != yes ]; then
    praxisbound_report 'FAIL' \
      "authority conflict: $praxisbound_used was used but the Story does not grant it"
    praxisbound_result_failed=$((praxisbound_result_failed + 1))
  fi
}

praxisbound_residual_bullet() {
  praxisbound_residual_count=$((praxisbound_residual_count + 1))
  praxisbound_is_exact_literal "$1" ||
    praxisbound_record_fail 'every residual risk must be one exact backticked statement'
}

praxisbound_check_result() {
  praxisbound_result_file="$praxisbound_story_directory/verification.md"

  if [ -L "$praxisbound_result_file" ]; then
    printf 'ERROR %s: verification record is a symlink: %s\n' \
      "$praxisbound_story_label" "$praxisbound_result_file" >&2
    praxisbound_operational_error=1
    return
  fi

  if [ ! -f "$praxisbound_result_file" ] || [ ! -r "$praxisbound_result_file" ] ||
    [ ! -s "$praxisbound_result_file" ]; then
    praxisbound_record_fail 'verification.md is missing, unreadable, or empty'
    return
  fi

  praxisbound_read_acceptance_ids

  praxisbound_checks_seen=
  praxisbound_check_report=
  praxisbound_evidence_seen=
  praxisbound_evidence_traced=0
  praxisbound_evidence_passed=' '
  praxisbound_residual_count=0
  praxisbound_result_failed=0

  praxisbound_scan_section "$praxisbound_result_file" '## Checks' \
    praxisbound_check_bullet
  praxisbound_checks_declared=$praxisbound_section_count

  praxisbound_scan_section "$praxisbound_result_file" '## Evidence' \
    praxisbound_evidence_bullet
  praxisbound_evidence_declared=$praxisbound_section_count

  praxisbound_scan_section "$praxisbound_result_file" '## Authority Used' \
    praxisbound_authority_used_bullet

  praxisbound_scan_section "$praxisbound_result_file" '## Residual Risks' \
    praxisbound_residual_bullet

  if [ "$praxisbound_checks_declared" -ne 1 ]; then
    praxisbound_record_fail 'verification.md must declare ## Checks exactly once'
    return
  fi

  if [ "$praxisbound_evidence_declared" -ne 1 ]; then
    praxisbound_record_fail 'verification.md must declare ## Evidence exactly once'
    return
  fi

  if [ "$praxisbound_ac_count" -eq 0 ]; then
    praxisbound_record_fail 'acceptance.md declares no checkbox AC to trace evidence to'
    return
  fi

  # A recorded result is complete only when every required check and every
  # acceptance criterion is accounted for. Silence is never PASS.
  praxisbound_missing=0

  for praxisbound_required_check in $praxisbound_required_checks
  do
    case "$praxisbound_check_report" in
      *"$praxisbound_required_check=pass "*) continue ;;
      *"$praxisbound_required_check="*)
        praxisbound_report 'WARN' \
          "required check did not pass: $praxisbound_required_check"
        ;;
      *)
        praxisbound_report 'WARN' \
          "required check is not recorded: $praxisbound_required_check"
        ;;
    esac
    praxisbound_missing=$((praxisbound_missing + 1))
  done

  if [ "$praxisbound_scope" = focused ]; then
    case "$praxisbound_check_report" in
      *'full=skipped '*)
        if [ "$praxisbound_residual_count" -eq 0 ]; then
          praxisbound_record_fail 'skipped full gate must retain a residual risk'
        fi
        ;;
      *'full=pass '*) ;;
      *)
        praxisbound_report 'WARN' 'focused result must record the full gate as skipped or passed'
        praxisbound_missing=$((praxisbound_missing + 1))
        ;;
    esac
  fi

  for praxisbound_required_ac in $praxisbound_ac_ids
  do
    case "$praxisbound_evidence_passed" in
      *" $praxisbound_required_ac "*) ;;
      *)
        praxisbound_report 'WARN' \
          "acceptance criterion has no passing evidence: $praxisbound_required_ac"
        praxisbound_missing=$((praxisbound_missing + 1))
        ;;
    esac
  done

  praxisbound_trim "$praxisbound_check_report"
  printf '  Checks: %s\n' "${praxisbound_trimmed:-none}"
  printf '  Evidence traced: %s of %s\n' \
    "$praxisbound_evidence_traced" "$praxisbound_ac_count"

  if [ "$praxisbound_result_failed" -gt 0 ]; then
    printf '  Status: FAIL\n'
    praxisbound_result_fail_total=$((praxisbound_result_fail_total + 1))
    return
  fi

  if [ "$praxisbound_missing" -gt 0 ]; then
    if [ "$praxisbound_residual_count" -eq 0 ]; then
      praxisbound_record_fail 'incomplete verification must record at least one residual risk'
    fi
    printf '  Status: PARTIAL\n'
    praxisbound_result_partial_total=$((praxisbound_result_partial_total + 1))
    return
  fi

  printf '  Status: PASS\n'
}

# --- Driver -----------------------------------------------------------------

praxisbound_check_story() {
  praxisbound_story_directory=$1
  praxisbound_story_label=$praxisbound_story_directory

  praxisbound_story_file="$praxisbound_story_directory/story.md"
  praxisbound_acceptance_file="$praxisbound_story_directory/acceptance.md"

  for praxisbound_required_story_file in \
    "$praxisbound_story_file" "$praxisbound_acceptance_file"
  do
    if [ -L "$praxisbound_required_story_file" ]; then
      printf 'ERROR %s: required Story file is a symlink: %s\n' \
        "$praxisbound_story_label" "$praxisbound_required_story_file" >&2
      praxisbound_operational_error=1
      return
    fi

    if [ ! -f "$praxisbound_required_story_file" ] ||
      [ ! -r "$praxisbound_required_story_file" ] ||
      [ ! -s "$praxisbound_required_story_file" ]; then
      printf 'ERROR %s: required Story file is missing or unreadable: %s\n' \
        "$praxisbound_story_label" "$praxisbound_required_story_file" >&2
      praxisbound_operational_error=1
      return
    fi
  done

  praxisbound_resolve_story
  praxisbound_print_plan

  if [ "$praxisbound_result" -eq 1 ]; then
    praxisbound_check_result
  fi
}

praxisbound_cr=$(printf '\r')
praxisbound_tab=$(printf '\t')
praxisbound_authority_keys='plan modify add_dependency migration commit push deploy'
praxisbound_check_layers='lint static unit integration contract e2e architecture documentation full'
praxisbound_unit_separator=$(printf '\037')
praxisbound_result=0

if [ "${1-}" = --result ]; then
  praxisbound_result=1
  shift
fi

case "${1-}" in
  --help)
    if [ "$#" -ne 1 ] || [ "$praxisbound_result" -eq 1 ]; then
      usage_error
      exit 2
    fi
    help
    exit 0
    ;;
  -*)
    usage_error
    exit 2
    ;;
esac

praxisbound_plan_incomplete=0
praxisbound_record_incomplete=0
praxisbound_result_fail_total=0
praxisbound_result_partial_total=0
praxisbound_operational_error=0
praxisbound_checked=0

printf 'PraxisBound Verification Check\n'

if [ "$#" -eq 0 ]; then
  if [ ! -d specs/stories ]; then
    printf 'ERROR Story directory is missing: specs/stories/\n' >&2
    printf '\nResult: ERROR\n'
    printf 'Stories checked: 0\n'
    exit 2
  fi

  for praxisbound_candidate in specs/stories/*
  do
    [ -d "$praxisbound_candidate" ] || continue

    case "$praxisbound_candidate" in
      */_template) continue ;;
    esac

    praxisbound_checked=$((praxisbound_checked + 1))
    praxisbound_check_story "$praxisbound_candidate"
  done
else
  for praxisbound_candidate in "$@"
  do
    case "$praxisbound_candidate" in
      -*) usage_error; exit 2 ;;
    esac

    if [ ! -d "$praxisbound_candidate" ]; then
      printf 'ERROR Story directory is missing: %s\n' \
        "$praxisbound_candidate" >&2
      praxisbound_operational_error=1
      continue
    fi

    praxisbound_checked=$((praxisbound_checked + 1))
    praxisbound_check_story "$praxisbound_candidate"
  done
fi

printf '\n'

if [ "$praxisbound_operational_error" -eq 1 ]; then
  printf 'Result: ERROR\n'
  printf 'Stories checked: %s\n' "$praxisbound_checked"
  exit 2
fi

if [ "$praxisbound_checked" -eq 0 ]; then
  printf 'ERROR No Story directory was checked\n' >&2
  printf 'Result: ERROR\n'
  printf 'Stories checked: 0\n'
  exit 2
fi

if [ "$praxisbound_result" -eq 0 ]; then
  if [ "$praxisbound_plan_incomplete" -gt 0 ]; then
    printf 'Result: VERIFICATION_PLAN_INCOMPLETE\n'
    printf 'Stories checked: %s\n\n' "$praxisbound_checked"
    printf 'Next:\n'
    printf 'Correct the reported task mode, authority, architecture, or risk\n'
    printf 'declaration in the Story, then run this check again.\n'
    exit 1
  fi

  printf 'Result: VERIFICATION_PLAN_OK\n'
  printf 'Stories checked: %s\n\n' "$praxisbound_checked"
  printf 'Next:\n'
  printf 'A resolved plan only. Run make verify, record the result, and take\n'
  printf 'the work to human review.\n'
  exit 0
fi

if [ "$praxisbound_plan_incomplete" -gt 0 ]; then
  printf 'Plan: VERIFICATION_PLAN_INCOMPLETE\n'
else
  printf 'Plan: VERIFICATION_PLAN_OK\n'
fi

if [ "$praxisbound_plan_incomplete" -gt 0 ] ||
  [ "$praxisbound_record_incomplete" -gt 0 ]; then
  printf 'Result: VERIFICATION_RESULT_INCOMPLETE\n'
  printf 'Stories checked: %s\n' "$praxisbound_checked"
  exit 1
fi

if [ "$praxisbound_result_fail_total" -gt 0 ]; then
  printf 'Result: VERIFICATION_FAIL\n'
  printf 'Stories checked: %s\n' "$praxisbound_checked"
  exit 1
fi

if [ "$praxisbound_result_partial_total" -gt 0 ]; then
  printf 'Result: VERIFICATION_PARTIAL\n'
  printf 'Stories checked: %s\n\n' "$praxisbound_checked"
  printf 'Next:\n'
  printf 'A required check or acceptance criterion is unproven. The Story is\n'
  printf 'not complete; resolve the recorded residual risk or record the\n'
  printf 'missing evidence.\n'
  exit 1
fi

printf 'Result: VERIFICATION_PASS\n'
printf 'Stories checked: %s\n\n' "$praxisbound_checked"
printf 'Next:\n'
printf 'Declared evidence only. Human Review still decides product, design,\n'
printf 'and architecture acceptance.\n'
