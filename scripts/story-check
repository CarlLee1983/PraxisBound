#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [story-directory ...]\n' "$0" >&2
  printf '       %s --ready [story-directory ...]\n' "$0" >&2
  printf '       %s --help\n' "$0" >&2
}

usage_error() {
  printf 'ERROR Invalid arguments\n' >&2
  usage
  printf '\nResult: ERROR\n'
  printf 'Stories checked: 0\n'
}

help() {
  printf 'PraxisBound Story Contract Check\n\n'
  printf 'Usage: %s [story-directory ...]\n' "$0"
  printf '       %s --ready [story-directory ...]\n' "$0"
  printf '       %s --help\n\n' "$0"
  printf 'Without arguments, every directory under specs/stories/ except\n'
  printf '_template/ is checked relative to the current directory.\n\n'
  printf 'The check is static and read-only. It never executes repository code\n'
  printf 'and never replaces make verify or human review.\n'
  printf '%s\n' '--ready also checks Goal, Scope, unique nonempty checkbox AC IDs, Acceptance Evidence, and declared risk contracts.'
  printf 'It checks minimum content, not human-approved READY.\n'
}

praxisbound_trim() {
  praxisbound_trimmed=$1

  while :; do
    case "$praxisbound_trimmed" in
      *"$praxisbound_cr") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_cr"} ;;
      *"$praxisbound_tab") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_tab"} ;;
      *' ') praxisbound_trimmed=${praxisbound_trimmed% } ;;
      *) break ;;
    esac
  done

  while :; do
    case "$praxisbound_trimmed" in
      "$praxisbound_cr"*) praxisbound_trimmed=${praxisbound_trimmed#"$praxisbound_cr"} ;;
      "$praxisbound_tab"*) praxisbound_trimmed=${praxisbound_trimmed#"$praxisbound_tab"} ;;
      ' '*) praxisbound_trimmed=${praxisbound_trimmed# } ;;
      *) break ;;
    esac
  done
}

# Track the documented Markdown fence subset with shell builtins. The caller
# initializes praxisbound_fence_length=0 before reading a file.
praxisbound_update_fence() {
  praxisbound_fence_line=$1
  praxisbound_fence_changed=0

  if [ "$praxisbound_fence_length" -eq 0 ]; then
    case "$praxisbound_fence_line" in
      '`'*) praxisbound_fence_character='`' ;;
      '~'*) praxisbound_fence_character='~' ;;
      *) return ;;
    esac

    praxisbound_fence_rest=$praxisbound_fence_line
    praxisbound_fence_run=0
    while :; do
      case "$praxisbound_fence_rest" in
        "$praxisbound_fence_character"*)
          praxisbound_fence_rest=${praxisbound_fence_rest#"$praxisbound_fence_character"}
          praxisbound_fence_run=$((praxisbound_fence_run + 1))
          ;;
        *) break ;;
      esac
    done

    if [ "$praxisbound_fence_run" -ge 3 ]; then
      praxisbound_fence_length=$praxisbound_fence_run
      praxisbound_fence_changed=1
    fi
    return
  fi

  case "$praxisbound_fence_line" in
    "$praxisbound_fence_character"*) ;;
    *) return ;;
  esac

  praxisbound_fence_rest=$praxisbound_fence_line
  praxisbound_fence_run=0
  while :; do
    case "$praxisbound_fence_rest" in
      "$praxisbound_fence_character"*)
        praxisbound_fence_rest=${praxisbound_fence_rest#"$praxisbound_fence_character"}
        praxisbound_fence_run=$((praxisbound_fence_run + 1))
        ;;
      *) break ;;
    esac
  done

  if [ "$praxisbound_fence_run" -ge "$praxisbound_fence_length" ] &&
    [ -z "$praxisbound_fence_rest" ]; then
    praxisbound_fence_length=0
    praxisbound_fence_changed=1
  fi
}

# A markdown separator cell: optional spaces, an optional leading colon, one or
# more dashes, an optional trailing colon, optional spaces. Written with shell
# builtins so the verdict cannot depend on the caller's PATH.
praxisbound_is_separator_cell() {
  praxisbound_cell_rest=$1

  while :; do
    case "$praxisbound_cell_rest" in
      ' '*) praxisbound_cell_rest=${praxisbound_cell_rest# } ;;
      *) break ;;
    esac
  done

  case "$praxisbound_cell_rest" in
    :*) praxisbound_cell_rest=${praxisbound_cell_rest#:} ;;
  esac

  case "$praxisbound_cell_rest" in
    -*) ;;
    *) return 1 ;;
  esac

  while :; do
    case "$praxisbound_cell_rest" in
      -*) praxisbound_cell_rest=${praxisbound_cell_rest#-} ;;
      *) break ;;
    esac
  done

  case "$praxisbound_cell_rest" in
    :*) praxisbound_cell_rest=${praxisbound_cell_rest#:} ;;
  esac

  while :; do
    case "$praxisbound_cell_rest" in
      ' '*) praxisbound_cell_rest=${praxisbound_cell_rest# } ;;
      *) break ;;
    esac
  done

  [ -z "$praxisbound_cell_rest" ]
}

praxisbound_is_five_column_separator() {
  case "$1" in
    '|'*) praxisbound_separator_rest=${1#'|'} ;;
    *) return 1 ;;
  esac

  praxisbound_separator_count=0

  while [ -n "$praxisbound_separator_rest" ]; do
    case "$praxisbound_separator_rest" in
      *'|'*) ;;
      *) return 1 ;;
    esac

    praxisbound_separator_cell=${praxisbound_separator_rest%%'|'*}
    praxisbound_separator_rest=${praxisbound_separator_rest#*'|'}

    praxisbound_is_separator_cell "$praxisbound_separator_cell" || return 1

    praxisbound_separator_count=$((praxisbound_separator_count + 1))

    if [ "$praxisbound_separator_count" -gt 5 ]; then
      return 1
    fi
  done

  [ "$praxisbound_separator_count" -eq 5 ]
}

# A quoted literal is the smallest machine-checkable evidence that a fixture
# records an exact value instead of prose such as "no credentials". Empty or
# blank backticks are not evidence.
praxisbound_has_literal() {
  praxisbound_literal_rest=$1

  while :; do
    case "$praxisbound_literal_rest" in
      *'`'*'`'*)
        praxisbound_literal_rest=${praxisbound_literal_rest#*'`'}
        praxisbound_literal_span=${praxisbound_literal_rest%%'`'*}
        praxisbound_literal_rest=${praxisbound_literal_rest#*'`'}

        case "$praxisbound_literal_span" in
          *[![:space:]]*) return 0 ;;
        esac
        ;;
      *) break ;;
    esac
  done

  return 1
}

# A placeholder is an unfilled template cell, not a payload that happens to
# contain angle brackets: `<script>alert(1)</script>` is a real fixture value.
praxisbound_is_placeholder() {
  case "$1" in
    ''|'*'|'-'|TBD|tbd|'N/A'|'n/a') return 0 ;;
    '<'*'>') return 0 ;;
  esac

  return 1
}

# Risk-contract fields are structurally exact literals even before readiness,
# but the normal contract check deliberately permits template placeholders.
praxisbound_is_structured_literal() {
  praxisbound_structured_literal=$1
  praxisbound_trim "$praxisbound_structured_literal"
  praxisbound_structured_literal=$praxisbound_trimmed

  case "$praxisbound_structured_literal" in
    \`*\`) ;;
    *) return 1 ;;
  esac

  praxisbound_structured_literal=${praxisbound_structured_literal#\`}
  praxisbound_structured_literal=${praxisbound_structured_literal%\`}
  case "$praxisbound_structured_literal" in
    ''|*'`'*) return 1 ;;
    *[![:space:]]*) return 0 ;;
    *) return 1 ;;
  esac
}

praxisbound_report() {
  printf '%s  %s: %s\n' "$1" "$praxisbound_story_label" "$2"
}

praxisbound_story_fail() {
  praxisbound_report 'FAIL' "$1"
  praxisbound_contract_incomplete=$((praxisbound_contract_incomplete + 1))
}

# Reads "* <label>: <value>" lines inside one Markdown section.
praxisbound_read_declaration() {
  praxisbound_declaration_file=$1
  praxisbound_declaration_section=$2
  praxisbound_declaration_label=$3
  praxisbound_declaration_value=
  praxisbound_declaration_count=0
  praxisbound_declaration_in_section=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_declaration_line ||
    [ -n "$praxisbound_declaration_line" ]; do
    praxisbound_trim "$praxisbound_declaration_line"
    praxisbound_declaration_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_declaration_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_declaration_line" in
      '#'*)
        if [ "$praxisbound_declaration_line" = "$praxisbound_declaration_section" ]
        then
          praxisbound_declaration_in_section=1
        else
          praxisbound_declaration_in_section=0
        fi
        continue
        ;;
    esac

    [ "$praxisbound_declaration_in_section" -eq 1 ] || continue

    case "$praxisbound_declaration_line" in
      '- '*)
        praxisbound_declaration_line="* ${praxisbound_declaration_line#'- '}"
        ;;
    esac

    case "$praxisbound_declaration_line" in
      "* $praxisbound_declaration_label: "*)
        praxisbound_declaration_count=$((praxisbound_declaration_count + 1))
        praxisbound_declaration_value=${praxisbound_declaration_line#"* $praxisbound_declaration_label: "}
        praxisbound_trim "$praxisbound_declaration_value"
        praxisbound_declaration_value=$praxisbound_trimmed
        ;;
    esac
  done <"$praxisbound_declaration_file"
}

# Counts "* ..." bullets carrying a quoted literal inside one section.
praxisbound_count_literal_bullets() {
  praxisbound_bullet_file=$1
  praxisbound_bullet_section=$2
  praxisbound_bullet_total=0
  praxisbound_bullet_literal=0
  praxisbound_bullet_section_found=0
  praxisbound_bullet_in_section=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_bullet_line ||
    [ -n "$praxisbound_bullet_line" ]; do
    praxisbound_trim "$praxisbound_bullet_line"
    praxisbound_bullet_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_bullet_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_bullet_line" in
      '#'*)
        if [ "$praxisbound_bullet_line" = "$praxisbound_bullet_section" ]; then
          praxisbound_bullet_section_found=1
          praxisbound_bullet_in_section=1
        else
          praxisbound_bullet_in_section=0
        fi
        continue
        ;;
    esac

    [ "$praxisbound_bullet_in_section" -eq 1 ] || continue

    case "$praxisbound_bullet_line" in
      '- '*) praxisbound_bullet_line="* ${praxisbound_bullet_line#'- '}" ;;
    esac

    case "$praxisbound_bullet_line" in
      '* '*)
        praxisbound_bullet_value=${praxisbound_bullet_line#'* '}
        praxisbound_trim "$praxisbound_bullet_value"
        praxisbound_bullet_value=$praxisbound_trimmed

        praxisbound_is_placeholder "$praxisbound_bullet_value" && continue

        praxisbound_bullet_total=$((praxisbound_bullet_total + 1))

        if praxisbound_has_literal "$praxisbound_bullet_value"; then
          praxisbound_bullet_literal=$((praxisbound_bullet_literal + 1))
        fi
        ;;
    esac
  done <"$praxisbound_bullet_file"
}

praxisbound_next_cell() {
  praxisbound_cell=

  while :; do
    case "$praxisbound_row" in
      *'|'*)
        praxisbound_cell_prefix=${praxisbound_row%%|*}
        praxisbound_row=${praxisbound_row#*|}
        praxisbound_backslashes=$praxisbound_cell_prefix
        praxisbound_backslash_count=0
        while :; do
          case "$praxisbound_backslashes" in
            *'\')
              praxisbound_backslashes=${praxisbound_backslashes%'\'}
              praxisbound_backslash_count=$((praxisbound_backslash_count + 1))
              ;;
            *) break ;;
          esac
        done
        praxisbound_cell=$praxisbound_cell$praxisbound_cell_prefix
        if [ $((praxisbound_backslash_count % 2)) -eq 1 ]; then
          praxisbound_cell=$praxisbound_cell'|'
        else
          break
        fi
        ;;
      *)
        praxisbound_cell=$praxisbound_cell$praxisbound_row
        praxisbound_row=
        break
        ;;
    esac
  done

  praxisbound_trim "$praxisbound_cell"
  praxisbound_cell=$praxisbound_trimmed
}

praxisbound_count_pipes() {
  praxisbound_pipe_rest=$1
  praxisbound_pipe_count=0

  while :; do
    case "$praxisbound_pipe_rest" in
      *'|'*)
        praxisbound_pipe_prefix=${praxisbound_pipe_rest%%|*}
        praxisbound_pipe_rest=${praxisbound_pipe_rest#*|}
        praxisbound_backslashes=$praxisbound_pipe_prefix
        praxisbound_backslash_count=0
        while :; do
          case "$praxisbound_backslashes" in
            *'\')
              praxisbound_backslashes=${praxisbound_backslashes%'\'}
              praxisbound_backslash_count=$((praxisbound_backslash_count + 1))
              ;;
            *) break ;;
          esac
        done
        if [ $((praxisbound_backslash_count % 2)) -eq 0 ]; then
          praxisbound_pipe_count=$((praxisbound_pipe_count + 1))
        fi
        ;;
      *) break ;;
    esac
  done
}

praxisbound_check_matrix_row() {
  praxisbound_row=$1
  praxisbound_row_number=$2

  praxisbound_count_pipes "$praxisbound_row"

  if [ "$praxisbound_pipe_count" -ne 6 ]; then
    praxisbound_story_fail "security fixture row $praxisbound_row_number must declare five columns"
    return
  fi

  praxisbound_row=${praxisbound_row#|}

  praxisbound_next_cell
  praxisbound_source_field=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_payload=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_expected=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_locations=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_verification=$praxisbound_cell

  for praxisbound_required_literal_column in \
    "source field=$praxisbound_source_field" \
    "payload=$praxisbound_payload" \
    "persisted locations=$praxisbound_locations" \
    "verification=$praxisbound_verification"
  do
    praxisbound_column_name=${praxisbound_required_literal_column%%=*}
    praxisbound_column_value=${praxisbound_required_literal_column#*=}

    if praxisbound_is_placeholder "$praxisbound_column_value"; then
      praxisbound_story_fail "security fixture row $praxisbound_row_number leaves $praxisbound_column_name unspecified"
      continue
    fi

    if ! praxisbound_has_literal "$praxisbound_column_value"; then
      praxisbound_story_fail "security fixture row $praxisbound_row_number states $praxisbound_column_name as prose instead of an exact value"
    fi
  done

  case "$praxisbound_expected" in
    preserve|redact|reject|omit) ;;
    *)
      praxisbound_story_fail "security fixture row $praxisbound_row_number expected result must be preserve, redact, reject, or omit"
      ;;
  esac
}

praxisbound_check_matrix() {
  praxisbound_matrix_file=$1
  praxisbound_matrix_found=0
  praxisbound_matrix_header=0
  praxisbound_matrix_separator=0
  praxisbound_matrix_rows=0
  praxisbound_matrix_in_section=0
  praxisbound_matrix_row_number=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_matrix_line ||
    [ -n "$praxisbound_matrix_line" ]; do
    praxisbound_trim "$praxisbound_matrix_line"
    praxisbound_matrix_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_matrix_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_matrix_line" in
      '#'*)
        if [ "$praxisbound_matrix_line" = '## Security Fixture Matrix' ]; then
          praxisbound_matrix_found=1
          praxisbound_matrix_in_section=1
        else
          praxisbound_matrix_in_section=0
        fi
        continue
        ;;
    esac

    [ "$praxisbound_matrix_in_section" -eq 1 ] || continue

    case "$praxisbound_matrix_line" in
      '|'*)
        if [ "$praxisbound_matrix_header" -eq 0 ]; then
          if [ "$praxisbound_matrix_line" = "$praxisbound_matrix_header_row" ]; then
            praxisbound_matrix_header=1
          else
            praxisbound_story_fail 'security fixture matrix header must be exactly the documented five columns'
            praxisbound_matrix_header=1
          fi
          continue
        fi

        if [ "$praxisbound_matrix_separator" -eq 0 ]; then
          praxisbound_matrix_separator=1

          praxisbound_is_five_column_separator "$praxisbound_matrix_line" ||
            praxisbound_story_fail 'security fixture matrix header must be followed by a five-column separator row'

          continue
        fi

        praxisbound_matrix_row_number=$((praxisbound_matrix_row_number + 1))
        praxisbound_matrix_rows=$((praxisbound_matrix_rows + 1))
        praxisbound_check_matrix_row \
          "$praxisbound_matrix_line" "$praxisbound_matrix_row_number"
        ;;
    esac
  done <"$praxisbound_matrix_file"
}

# Unlike matrix placeholders, readiness uses a finite list, not an angle-bracket
# pattern: technical requirements such as <T> are valid content.
praxisbound_ready_content() {
  praxisbound_trim "$1"
  case "$praxisbound_trimmed" in
    '* '*|'- '*) praxisbound_trim "${praxisbound_trimmed#??}" ;;
  esac
  case "$praxisbound_trimmed" in
    ''|'*'|'-'|TBD|tbd|TODO|todo|'N/A'|'n/a'|'...'|'<goal>'|'<scope>'|\
    '<acceptance criterion>'|'Describe the user or business outcome.') return 1 ;;
  esac
  return 0
}

praxisbound_ready_fail() {
  praxisbound_report 'FAIL' "readiness: $1"
  praxisbound_readiness_incomplete=$((praxisbound_readiness_incomplete + 1))
}

praxisbound_is_exact_literal() {
  praxisbound_exact_literal=$1
  praxisbound_trim "$praxisbound_exact_literal"
  praxisbound_exact_literal=$praxisbound_trimmed

  case "$praxisbound_exact_literal" in
    \`*\`) ;;
    *) return 1 ;;
  esac

  praxisbound_exact_literal=${praxisbound_exact_literal#\`}
  praxisbound_exact_literal=${praxisbound_exact_literal%\`}
  case "$praxisbound_exact_literal" in
    ''|*'`'*) return 1 ;;
    *[![:space:]]*) ;;
    *) return 1 ;;
  esac

  praxisbound_is_evidence_placeholder "$praxisbound_exact_literal" && return 1
  return 0
}

praxisbound_is_evidence_placeholder() {
  case "$1" in
    ''|'*'|'-'|TBD|tbd|TODO|todo|'N/A'|'n/a'|'...'|'<evidence>'|'<fixture>'|\
    '<fixture / precondition>'|'<expected observation>') return 0 ;;
  esac
  return 1
}

praxisbound_is_risk_contract_placeholder() {
  case "$1" in
    ''|'*'|'-'|TBD|tbd|TODO|todo|'N/A'|'n/a'|'...'|'<value>'|\
    '<source failure>'|'<public projection>'|'<detail policy>'|\
    '<contended resource>'|'<linearization point>'|'<conflict outcome>'|\
    '<bounded resource>'|'<limit>'|'<saturation behavior>'|\
    '<failure projection>'|'<retained resource>'|'<retention bound>'|\
    '<overflow policy>'|'<recovery / observability>'|'<evidence ac>') return 0 ;;
  esac
  return 1
}

praxisbound_check_acceptance_evidence_row() {
  praxisbound_row=$1
  praxisbound_row_number=$2
  praxisbound_count_pipes "$praxisbound_row"
  if [ "$praxisbound_pipe_count" -ne 6 ]; then
    praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number must declare five columns"
    return
  fi

  praxisbound_row=${praxisbound_row#|}
  praxisbound_next_cell
  praxisbound_evidence_ac_cell=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_evidence_method=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_evidence_value=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_evidence_fixture=$praxisbound_cell
  praxisbound_next_cell
  praxisbound_evidence_observation=$praxisbound_cell

  if [ -n "$praxisbound_row" ]; then
    praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number must end after the fifth column"
    return
  fi

  praxisbound_evidence_ac_id=
  case "$praxisbound_evidence_ac_cell" in
    \`AC-*\`)
      praxisbound_evidence_ac_id=${praxisbound_evidence_ac_cell#\`}
      praxisbound_evidence_ac_id=${praxisbound_evidence_ac_id%\`}
      case "${praxisbound_evidence_ac_id#AC-}" in
        ''|*[!0-9]*) praxisbound_evidence_ac_id= ;;
      esac
      ;;
  esac
  if [ -z "$praxisbound_evidence_ac_id" ] ||
    [ "$praxisbound_evidence_ac_cell" != "\`$praxisbound_evidence_ac_id\`" ]; then
    praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number must name one exact backticked AC-<digits> ID"
  else
    case "$praxisbound_ac_ids" in
      *" $praxisbound_evidence_ac_id "*) ;;
      *) praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number names unknown AC ID: $praxisbound_evidence_ac_id" ;;
    esac
    case "$praxisbound_evidence_ids" in
      *" $praxisbound_evidence_ac_id "*) praxisbound_ready_fail "acceptance evidence duplicates AC ID: $praxisbound_evidence_ac_id" ;;
    esac
    praxisbound_evidence_ids="$praxisbound_evidence_ids$praxisbound_evidence_ac_id "
  fi

  case "$praxisbound_evidence_method" in
    test|command|human) ;;
    *) praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number method must be test, command, or human" ;;
  esac

  for praxisbound_evidence_required in \
    "evidence=$praxisbound_evidence_value" \
    "fixture / precondition=$praxisbound_evidence_fixture" \
    "expected observation=$praxisbound_evidence_observation"
  do
    praxisbound_evidence_column=${praxisbound_evidence_required%%=*}
    praxisbound_evidence_cell=${praxisbound_evidence_required#*=}
    if praxisbound_is_evidence_placeholder "$praxisbound_evidence_cell"; then
      praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number leaves $praxisbound_evidence_column unspecified"
    elif ! praxisbound_is_exact_literal "$praxisbound_evidence_cell"; then
      praxisbound_ready_fail "acceptance evidence row $praxisbound_row_number must give $praxisbound_evidence_column as one exact backticked value"
    fi
  done
}

praxisbound_check_acceptance_evidence() {
  praxisbound_evidence_found=0
  praxisbound_evidence_header=0
  praxisbound_evidence_separator=0
  praxisbound_evidence_rows=0
  praxisbound_evidence_in_section=0
  praxisbound_evidence_row_number=0
  praxisbound_evidence_ids=' '
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_evidence_line || [ -n "$praxisbound_evidence_line" ]; do
    praxisbound_trim "$praxisbound_evidence_line"
    praxisbound_evidence_line=$praxisbound_trimmed
    praxisbound_update_fence "$praxisbound_evidence_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue
    case "$praxisbound_evidence_line" in
      '#'* )
        if [ "$praxisbound_evidence_line" = '## Acceptance Evidence' ]; then
          praxisbound_evidence_found=$((praxisbound_evidence_found + 1))
          praxisbound_evidence_in_section=1
        else
          praxisbound_evidence_in_section=0
        fi
        continue
        ;;
    esac
    [ "$praxisbound_evidence_in_section" -eq 1 ] || continue
    case "$praxisbound_evidence_line" in
      '|'*)
        if [ "$praxisbound_evidence_header" -eq 0 ]; then
          if [ "$praxisbound_evidence_line" != "$praxisbound_evidence_header_row" ]; then
            praxisbound_ready_fail 'acceptance evidence header must be exactly the documented five columns'
          fi
          praxisbound_evidence_header=1
          continue
        fi
        if [ "$praxisbound_evidence_separator" -eq 0 ]; then
          praxisbound_evidence_separator=1
          praxisbound_is_five_column_separator "$praxisbound_evidence_line" ||
            praxisbound_ready_fail 'acceptance evidence header must be followed by a five-column separator row'
          continue
        fi
        praxisbound_evidence_row_number=$((praxisbound_evidence_row_number + 1))
        praxisbound_evidence_rows=$((praxisbound_evidence_rows + 1))
        praxisbound_check_acceptance_evidence_row \
          "$praxisbound_evidence_line" "$praxisbound_evidence_row_number"
        ;;
    esac
  done <"$praxisbound_acceptance_file"

  if [ "$praxisbound_evidence_found" -eq 0 ]; then
    praxisbound_ready_fail 'acceptance.md is missing ## Acceptance Evidence'
  elif [ "$praxisbound_evidence_found" -ne 1 ]; then
    praxisbound_ready_fail 'acceptance.md must declare ## Acceptance Evidence exactly once'
  elif [ "$praxisbound_evidence_rows" -eq 0 ]; then
    praxisbound_ready_fail 'acceptance evidence declares no rows'
  fi

  for praxisbound_evidence_required_ac in $praxisbound_ac_ids
  do
    case "$praxisbound_evidence_ids" in
      *" $praxisbound_evidence_required_ac "*) ;;
      *) praxisbound_ready_fail "acceptance evidence is missing AC ID: $praxisbound_evidence_required_ac" ;;
    esac
  done
}

praxisbound_check_readiness() {
  praxisbound_ready_section=
  praxisbound_goal_content=0
  praxisbound_scope_content=0
  praxisbound_fence_length=0
  while IFS= read -r praxisbound_ready_line || [ -n "$praxisbound_ready_line" ]; do
    praxisbound_trim "$praxisbound_ready_line"
    praxisbound_ready_line=$praxisbound_trimmed
    praxisbound_update_fence "$praxisbound_ready_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue
    case "$praxisbound_ready_line" in
      '## Goal') praxisbound_ready_section=goal; continue ;;
      '## Scope') praxisbound_ready_section=scope; continue ;;
      '#'|'##'|'# '*|'## '*|"#$praxisbound_tab"*|"##$praxisbound_tab"*)
        praxisbound_ready_section=; continue ;;
      '###'*) continue ;;
    esac
    praxisbound_ready_content "$praxisbound_ready_line" || continue
    case "$praxisbound_ready_section" in
      goal) praxisbound_goal_content=1 ;;
      scope) praxisbound_scope_content=1 ;;
    esac
  done <"$praxisbound_story_file"
  [ "$praxisbound_goal_content" -eq 1 ] ||
    praxisbound_ready_fail '## Goal needs non-placeholder content'
  [ "$praxisbound_scope_content" -eq 1 ] ||
    praxisbound_ready_fail '## Scope needs non-placeholder content'

  praxisbound_ac_ids=' '
  praxisbound_ac_count=0
  praxisbound_fence_length=0
  while IFS= read -r praxisbound_ready_line || [ -n "$praxisbound_ready_line" ]; do
    praxisbound_trim "$praxisbound_ready_line"
    praxisbound_ready_line=$praxisbound_trimmed
    praxisbound_update_fence "$praxisbound_ready_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue
    case "$praxisbound_ready_line" in
      '* '*|'- '*) praxisbound_ready_line=${praxisbound_ready_line#??} ;;
      *) continue ;;
    esac
    case "$praxisbound_ready_line" in
      '[ ] '*|'[x] '*|'[X] '*) praxisbound_ready_line=${praxisbound_ready_line#????} ;;
      *) continue ;;
    esac
    case "$praxisbound_ready_line" in
      AC-*:* ) ;;
      *) continue ;;
    esac
    praxisbound_ac_id=${praxisbound_ready_line%%:*}
    case "${praxisbound_ac_id#AC-}" in
      ''|*[!0-9]*) continue ;;
    esac
    case "$praxisbound_ac_ids" in
      *" $praxisbound_ac_id "*) praxisbound_ready_fail "duplicate AC ID: $praxisbound_ac_id" ;;
    esac
    praxisbound_ac_ids="$praxisbound_ac_ids$praxisbound_ac_id "
    praxisbound_ac_count=$((praxisbound_ac_count + 1))
    praxisbound_ready_content "${praxisbound_ready_line#*:}" ||
      praxisbound_ready_fail "$praxisbound_ac_id needs non-placeholder same-line content"
  done <"$praxisbound_acceptance_file"
  [ "$praxisbound_ac_count" -gt 0 ] ||
    praxisbound_ready_fail 'acceptance.md needs a checkbox AC-<digits>: criterion'
  praxisbound_check_acceptance_evidence
}

# --- Execution governance declarations --------------------------------------
#
# Task mode, Authority, Architecture, and Risk are optional. A Story written
# before they existed declares none of them and keeps its previous verdict; the
# documented defaults are resolved by scripts/verification-check, not here. This
# checker judges only what a Story actually declares.

praxisbound_scan_section() {
  praxisbound_scan_file=$1
  praxisbound_scan_heading=$2
  praxisbound_scan_callback=$3
  praxisbound_section_count=0
  praxisbound_scan_in=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_scan_line || [ -n "$praxisbound_scan_line" ]; do
    praxisbound_trim "$praxisbound_scan_line"
    praxisbound_scan_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_scan_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_scan_line" in
      '#'*)
        if [ "$praxisbound_scan_line" = "$praxisbound_scan_heading" ]; then
          praxisbound_section_count=$((praxisbound_section_count + 1))
          praxisbound_scan_in=1
        else
          praxisbound_scan_in=0
        fi
        continue
        ;;
    esac

    [ "$praxisbound_scan_in" -eq 1 ] || continue

    case "$praxisbound_scan_line" in
      '- '*) praxisbound_scan_line="* ${praxisbound_scan_line#'- '}" ;;
    esac

    case "$praxisbound_scan_line" in
      '* '*) ;;
      *) continue ;;
    esac

    praxisbound_scan_bullet=${praxisbound_scan_line#'* '}
    praxisbound_trim "$praxisbound_scan_bullet"
    praxisbound_scan_bullet=$praxisbound_trimmed
    [ -n "$praxisbound_scan_bullet" ] || continue

    "$praxisbound_scan_callback" "$praxisbound_scan_bullet"
  done <"$praxisbound_scan_file"
}

praxisbound_gov_split() {
  praxisbound_gov_label=
  praxisbound_gov_value=

  case "$1" in
    *': '*)
      praxisbound_gov_label=${1%%': '*}
      praxisbound_gov_value=${1#*': '}
      ;;
    *':')
      praxisbound_gov_label=${1%':'}
      ;;
    *) return 1 ;;
  esac

  praxisbound_trim "$praxisbound_gov_label"
  praxisbound_gov_label=$praxisbound_trimmed
  praxisbound_trim "$praxisbound_gov_value"
  praxisbound_gov_value=$praxisbound_trimmed
  [ -n "$praxisbound_gov_label" ]
}

praxisbound_gov_unquote() {
  praxisbound_gov_unquoted=$1
  praxisbound_gov_unquoted=${praxisbound_gov_unquoted#\`}
  praxisbound_gov_unquoted=${praxisbound_gov_unquoted%\`}
}

praxisbound_task_mode_bullet() {
  praxisbound_gov_split "$1" || return 0
  [ "$praxisbound_gov_label" = 'Task mode' ] || return 0
  praxisbound_task_mode_count=$((praxisbound_task_mode_count + 1))
  praxisbound_task_mode=$praxisbound_gov_value
}

praxisbound_authority_bullet() {
  if ! praxisbound_gov_split "$1"; then
    praxisbound_story_fail "authority entry is not a declaration: $1"
    return 0
  fi

  case " $praxisbound_authority_keys " in
    *" $praxisbound_gov_label "*) ;;
    *)
      praxisbound_story_fail "authority declares an unknown operation: $praxisbound_gov_label"
      return 0
      ;;
  esac

  case " $praxisbound_authority_seen " in
    *" $praxisbound_gov_label "*)
      praxisbound_story_fail "authority declares $praxisbound_gov_label more than once"
      return 0
      ;;
  esac
  praxisbound_authority_seen="$praxisbound_authority_seen $praxisbound_gov_label"

  case "$praxisbound_gov_value" in
    yes|no) ;;
    *)
      praxisbound_story_fail "authority $praxisbound_gov_label must be declared as yes or no"
      return 0
      ;;
  esac

  eval "praxisbound_authority_$praxisbound_gov_label=\$praxisbound_gov_value"
}

praxisbound_architecture_bullet() {
  if ! praxisbound_gov_split "$1"; then
    praxisbound_story_fail "architecture entry is not a declaration: $1"
    return 0
  fi

  case "$praxisbound_gov_label" in
    Impact)
      praxisbound_impact_count=$((praxisbound_impact_count + 1))
      praxisbound_impact=$praxisbound_gov_value
      return 0
      ;;
    Decision|Boundary|Contract|Owner) ;;
    *)
      praxisbound_story_fail "architecture declares an unknown label: $praxisbound_gov_label"
      return 0
      ;;
  esac

  if ! praxisbound_is_exact_literal "$praxisbound_gov_value"; then
    praxisbound_story_fail "architecture $praxisbound_gov_label must state one exact backticked value"
    return 0
  fi

  praxisbound_gov_unquote "$praxisbound_gov_value"

  case "$praxisbound_gov_label" in
    Decision)
      praxisbound_decision_count=$((praxisbound_decision_count + 1))
      case " $praxisbound_decisions " in
        *" $praxisbound_gov_unquoted "*)
          praxisbound_story_fail "architecture references the same decision twice: $praxisbound_gov_unquoted"
          return 0
          ;;
      esac
      praxisbound_decisions="$praxisbound_decisions$praxisbound_gov_unquoted "
      ;;
    Boundary)
      praxisbound_boundary_count=$((praxisbound_boundary_count + 1))
      praxisbound_boundaries="$praxisbound_boundaries$praxisbound_gov_unquoted$praxisbound_unit_separator"
      ;;
    Contract)
      praxisbound_contract_count=$((praxisbound_contract_count + 1))
      ;;
    Owner)
      praxisbound_owner_count=$((praxisbound_owner_count + 1))
      praxisbound_owners="$praxisbound_owners$praxisbound_gov_unquoted$praxisbound_unit_separator"
      ;;
  esac
}

praxisbound_risk_bullet() {
  if ! praxisbound_gov_split "$1"; then
    praxisbound_story_fail "risk entry is not a declaration: $1"
    return 0
  fi

  case "$praxisbound_gov_label" in
    Level)
      praxisbound_risk_level_count=$((praxisbound_risk_level_count + 1))
      praxisbound_risk_level=$praxisbound_gov_value
      ;;
    Reason)
      praxisbound_reason_count=$((praxisbound_reason_count + 1))
      if praxisbound_is_exact_literal "$praxisbound_gov_value"; then
        praxisbound_gov_unquote "$praxisbound_gov_value"
        praxisbound_reasons="$praxisbound_reasons$praxisbound_gov_unquoted "
      else
        praxisbound_story_fail 'risk reason must name one same-line backticked signal'
      fi
      ;;
    Signal)
      if ! praxisbound_is_structured_literal "$praxisbound_gov_value"; then
        praxisbound_story_fail 'risk signal must name one same-line backticked value'
        return 0
      fi
      praxisbound_gov_unquote "$praxisbound_gov_value"
      case " $praxisbound_standard_risk_signals " in
        *" $praxisbound_gov_unquoted "*) ;;
        *)
          praxisbound_story_fail "risk signal is unknown: $praxisbound_gov_unquoted"
          return 0
          ;;
      esac
      case "$praxisbound_risk_signals" in
        *" $praxisbound_gov_unquoted "*)
          praxisbound_story_fail "risk signal is declared more than once: $praxisbound_gov_unquoted"
          return 0
          ;;
      esac
      praxisbound_risk_signals="$praxisbound_risk_signals$praxisbound_gov_unquoted "
      ;;
    *)
      praxisbound_story_fail "risk declares an unknown label: $praxisbound_gov_label"
      ;;
  esac
}

praxisbound_scope_bullet() {
  if ! praxisbound_gov_split "$1"; then
    praxisbound_story_fail "verification scope entry is not a declaration: $1"
    return 0
  fi

  case "$praxisbound_gov_label" in
    Scope)
      praxisbound_scope_count=$((praxisbound_scope_count + 1))
      praxisbound_scope=$praxisbound_gov_value
      ;;
    Surface)
      praxisbound_surface_count=$((praxisbound_surface_count + 1))
      praxisbound_surface=$praxisbound_gov_value
      ;;
    *)
      case " $praxisbound_scope_layers " in
        *" $praxisbound_gov_label "*) ;;
        *)
          praxisbound_story_fail "verification scope declares an unknown check: $praxisbound_gov_label"
          return 0
          ;;
      esac
      case " $praxisbound_scope_seen " in
        *" $praxisbound_gov_label "*)
          praxisbound_story_fail "verification scope declares $praxisbound_gov_label more than once"
          return 0
          ;;
      esac
      praxisbound_scope_seen="$praxisbound_scope_seen $praxisbound_gov_label"
      praxisbound_is_exact_literal "$praxisbound_gov_value" ||
        praxisbound_story_fail "verification scope $praxisbound_gov_label must name one exact backticked command"
      ;;
  esac
}

praxisbound_risk_contract_bullet() {
  if ! praxisbound_gov_split "$1"; then
    praxisbound_story_fail "$praxisbound_risk_contract_name entry is not a declaration: $1"
    return 0
  fi

  case "$praxisbound_risk_contract_kind:$praxisbound_gov_label" in
    error-projection:'Source failure')
      praxisbound_source_failure_count=$((praxisbound_source_failure_count + 1))
      praxisbound_source_failure=$praxisbound_gov_value ;;
    error-projection:'Public projection')
      praxisbound_public_projection_count=$((praxisbound_public_projection_count + 1))
      praxisbound_public_projection=$praxisbound_gov_value ;;
    error-projection:'Detail policy')
      praxisbound_detail_policy_count=$((praxisbound_detail_policy_count + 1))
      praxisbound_detail_policy=$praxisbound_gov_value ;;
    error-projection:'Evidence AC')
      praxisbound_contract_evidence_ac_count=$((praxisbound_contract_evidence_ac_count + 1))
      praxisbound_contract_evidence_ac=$praxisbound_gov_value ;;
    concurrency:'Contended resource')
      praxisbound_contended_resource_count=$((praxisbound_contended_resource_count + 1))
      praxisbound_contended_resource=$praxisbound_gov_value ;;
    concurrency:'Linearization point')
      praxisbound_linearization_point_count=$((praxisbound_linearization_point_count + 1))
      praxisbound_linearization_point=$praxisbound_gov_value ;;
    concurrency:'Conflict outcome')
      praxisbound_conflict_outcome_count=$((praxisbound_conflict_outcome_count + 1))
      praxisbound_conflict_outcome=$praxisbound_gov_value ;;
    concurrency:'Evidence AC')
      praxisbound_contract_evidence_ac_count=$((praxisbound_contract_evidence_ac_count + 1))
      praxisbound_contract_evidence_ac=$praxisbound_gov_value ;;
    bounded-capacity:'Bounded resource')
      praxisbound_bounded_resource_count=$((praxisbound_bounded_resource_count + 1))
      praxisbound_bounded_resource=$praxisbound_gov_value ;;
    bounded-capacity:Limit)
      praxisbound_capacity_limit_count=$((praxisbound_capacity_limit_count + 1))
      praxisbound_capacity_limit=$praxisbound_gov_value ;;
    bounded-capacity:'Saturation behavior')
      praxisbound_saturation_behavior_count=$((praxisbound_saturation_behavior_count + 1))
      praxisbound_saturation_behavior=$praxisbound_gov_value ;;
    bounded-capacity:'Failure projection')
      praxisbound_failure_projection_count=$((praxisbound_failure_projection_count + 1))
      praxisbound_failure_projection=$praxisbound_gov_value ;;
    bounded-capacity:'Evidence AC')
      praxisbound_contract_evidence_ac_count=$((praxisbound_contract_evidence_ac_count + 1))
      praxisbound_contract_evidence_ac=$praxisbound_gov_value ;;
    retention-overflow:'Retained resource')
      praxisbound_retained_resource_count=$((praxisbound_retained_resource_count + 1))
      praxisbound_retained_resource=$praxisbound_gov_value ;;
    retention-overflow:'Retention bound')
      praxisbound_retention_bound_count=$((praxisbound_retention_bound_count + 1))
      praxisbound_retention_bound=$praxisbound_gov_value ;;
    retention-overflow:'Overflow policy')
      praxisbound_overflow_policy_count=$((praxisbound_overflow_policy_count + 1))
      praxisbound_overflow_policy=$praxisbound_gov_value ;;
    retention-overflow:'Recovery / observability')
      praxisbound_recovery_observability_count=$((praxisbound_recovery_observability_count + 1))
      praxisbound_recovery_observability=$praxisbound_gov_value ;;
    retention-overflow:'Evidence AC')
      praxisbound_contract_evidence_ac_count=$((praxisbound_contract_evidence_ac_count + 1))
      praxisbound_contract_evidence_ac=$praxisbound_gov_value ;;
    *) praxisbound_story_fail "$praxisbound_risk_contract_name declares an unknown label: $praxisbound_gov_label" ;;
  esac
}

praxisbound_require_risk_contract_field() {
  praxisbound_contract_field_label=$1
  praxisbound_contract_field_count=$2
  praxisbound_contract_field_value=$3

  if [ "$praxisbound_contract_field_count" -ne 1 ]; then
    praxisbound_story_fail "$praxisbound_risk_contract_name must declare \"$praxisbound_contract_field_label\" exactly once"
    return
  fi

  if ! praxisbound_is_structured_literal "$praxisbound_contract_field_value"; then
    praxisbound_story_fail "$praxisbound_risk_contract_name $praxisbound_contract_field_label must state one exact same-line backticked value"
    return
  fi

  if [ "$praxisbound_ready" -eq 1 ]; then
    praxisbound_gov_unquote "$praxisbound_contract_field_value"
    if praxisbound_is_risk_contract_placeholder "$praxisbound_gov_unquoted"; then
      praxisbound_ready_fail "$praxisbound_risk_contract_name $praxisbound_contract_field_label is a placeholder"
    fi
  fi
}

praxisbound_check_risk_evidence_ac() {
  [ "$praxisbound_ready" -eq 1 ] || return 0
  [ "$praxisbound_contract_evidence_ac_count" -eq 1 ] || return 0
  praxisbound_is_structured_literal "$praxisbound_contract_evidence_ac" || return 0

  praxisbound_gov_unquote "$praxisbound_contract_evidence_ac"
  praxisbound_risk_evidence_ac=$praxisbound_gov_unquoted
  case "$praxisbound_risk_evidence_ac" in
    AC-*)
      case "${praxisbound_risk_evidence_ac#AC-}" in
        ''|*[!0-9]*) praxisbound_risk_evidence_ac= ;;
      esac
      ;;
    *) praxisbound_risk_evidence_ac= ;;
  esac

  if [ -z "$praxisbound_risk_evidence_ac" ]; then
    praxisbound_ready_fail "$praxisbound_risk_contract_name Evidence AC must name one exact AC-<digits> ID"
    return
  fi

  case "$praxisbound_ac_ids" in
    *" $praxisbound_risk_evidence_ac "*) ;;
    *)
      praxisbound_ready_fail "$praxisbound_risk_contract_name Evidence AC names unknown AC ID: $praxisbound_risk_evidence_ac"
      return
      ;;
  esac

  case "$praxisbound_evidence_ids" in
    *" $praxisbound_risk_evidence_ac "*) ;;
    *) praxisbound_ready_fail "$praxisbound_risk_contract_name Evidence AC has no Acceptance Evidence row: $praxisbound_risk_evidence_ac" ;;
  esac
}

praxisbound_check_error_projection_contract() {
  praxisbound_risk_contract_kind=error-projection
  praxisbound_risk_contract_name='Error Projection'
  praxisbound_source_failure_count=0
  praxisbound_source_failure=
  praxisbound_public_projection_count=0
  praxisbound_public_projection=
  praxisbound_detail_policy_count=0
  praxisbound_detail_policy=
  praxisbound_contract_evidence_ac_count=0
  praxisbound_contract_evidence_ac=
  praxisbound_scan_section "$praxisbound_story_file" '## Error Projection' \
    praxisbound_risk_contract_bullet
  if [ "$praxisbound_section_count" -ne 1 ]; then
    praxisbound_story_fail 'risk signal error-projection requires ## Error Projection exactly once'
    return
  fi
  praxisbound_require_risk_contract_field 'Source failure' "$praxisbound_source_failure_count" "$praxisbound_source_failure"
  praxisbound_require_risk_contract_field 'Public projection' "$praxisbound_public_projection_count" "$praxisbound_public_projection"
  praxisbound_require_risk_contract_field 'Detail policy' "$praxisbound_detail_policy_count" "$praxisbound_detail_policy"
  praxisbound_require_risk_contract_field 'Evidence AC' "$praxisbound_contract_evidence_ac_count" "$praxisbound_contract_evidence_ac"
  praxisbound_check_risk_evidence_ac
}

praxisbound_check_concurrency_contract() {
  praxisbound_risk_contract_kind=concurrency
  praxisbound_risk_contract_name='Concurrency'
  praxisbound_contended_resource_count=0
  praxisbound_contended_resource=
  praxisbound_linearization_point_count=0
  praxisbound_linearization_point=
  praxisbound_conflict_outcome_count=0
  praxisbound_conflict_outcome=
  praxisbound_contract_evidence_ac_count=0
  praxisbound_contract_evidence_ac=
  praxisbound_scan_section "$praxisbound_story_file" '## Concurrency' \
    praxisbound_risk_contract_bullet
  if [ "$praxisbound_section_count" -ne 1 ]; then
    praxisbound_story_fail 'risk signal concurrency requires ## Concurrency exactly once'
    return
  fi
  praxisbound_require_risk_contract_field 'Contended resource' "$praxisbound_contended_resource_count" "$praxisbound_contended_resource"
  praxisbound_require_risk_contract_field 'Linearization point' "$praxisbound_linearization_point_count" "$praxisbound_linearization_point"
  praxisbound_require_risk_contract_field 'Conflict outcome' "$praxisbound_conflict_outcome_count" "$praxisbound_conflict_outcome"
  praxisbound_require_risk_contract_field 'Evidence AC' "$praxisbound_contract_evidence_ac_count" "$praxisbound_contract_evidence_ac"
  praxisbound_check_risk_evidence_ac
}

praxisbound_check_capacity_contract() {
  praxisbound_risk_contract_kind=bounded-capacity
  praxisbound_risk_contract_name='Capacity'
  praxisbound_bounded_resource_count=0
  praxisbound_bounded_resource=
  praxisbound_capacity_limit_count=0
  praxisbound_capacity_limit=
  praxisbound_saturation_behavior_count=0
  praxisbound_saturation_behavior=
  praxisbound_failure_projection_count=0
  praxisbound_failure_projection=
  praxisbound_contract_evidence_ac_count=0
  praxisbound_contract_evidence_ac=
  praxisbound_scan_section "$praxisbound_story_file" '## Capacity' \
    praxisbound_risk_contract_bullet
  if [ "$praxisbound_section_count" -ne 1 ]; then
    praxisbound_story_fail 'risk signal bounded-capacity requires ## Capacity exactly once'
    return
  fi
  praxisbound_require_risk_contract_field 'Bounded resource' "$praxisbound_bounded_resource_count" "$praxisbound_bounded_resource"
  praxisbound_require_risk_contract_field 'Limit' "$praxisbound_capacity_limit_count" "$praxisbound_capacity_limit"
  praxisbound_require_risk_contract_field 'Saturation behavior' "$praxisbound_saturation_behavior_count" "$praxisbound_saturation_behavior"
  praxisbound_require_risk_contract_field 'Failure projection' "$praxisbound_failure_projection_count" "$praxisbound_failure_projection"
  praxisbound_require_risk_contract_field 'Evidence AC' "$praxisbound_contract_evidence_ac_count" "$praxisbound_contract_evidence_ac"
  praxisbound_check_risk_evidence_ac
}

praxisbound_check_retention_contract() {
  praxisbound_risk_contract_kind=retention-overflow
  praxisbound_risk_contract_name='Retention and Overflow'
  praxisbound_retained_resource_count=0
  praxisbound_retained_resource=
  praxisbound_retention_bound_count=0
  praxisbound_retention_bound=
  praxisbound_overflow_policy_count=0
  praxisbound_overflow_policy=
  praxisbound_recovery_observability_count=0
  praxisbound_recovery_observability=
  praxisbound_contract_evidence_ac_count=0
  praxisbound_contract_evidence_ac=
  praxisbound_scan_section "$praxisbound_story_file" '## Retention and Overflow' \
    praxisbound_risk_contract_bullet
  if [ "$praxisbound_section_count" -ne 1 ]; then
    praxisbound_story_fail 'risk signal retention-overflow requires ## Retention and Overflow exactly once'
    return
  fi
  praxisbound_require_risk_contract_field 'Retained resource' "$praxisbound_retained_resource_count" "$praxisbound_retained_resource"
  praxisbound_require_risk_contract_field 'Retention bound' "$praxisbound_retention_bound_count" "$praxisbound_retention_bound"
  praxisbound_require_risk_contract_field 'Overflow policy' "$praxisbound_overflow_policy_count" "$praxisbound_overflow_policy"
  praxisbound_require_risk_contract_field 'Recovery / observability' "$praxisbound_recovery_observability_count" "$praxisbound_recovery_observability"
  praxisbound_require_risk_contract_field 'Evidence AC' "$praxisbound_contract_evidence_ac_count" "$praxisbound_contract_evidence_ac"
  praxisbound_check_risk_evidence_ac
}

praxisbound_check_risk_contracts() {
  for praxisbound_declared_signal in $praxisbound_risk_signals
  do
    case "$praxisbound_declared_signal" in
      error-projection) praxisbound_check_error_projection_contract ;;
      concurrency) praxisbound_check_concurrency_contract ;;
      bounded-capacity) praxisbound_check_capacity_contract ;;
      retention-overflow) praxisbound_check_retention_contract ;;
    esac
  done
  return 0
}

# Reads a decision record's single "* Status: <value>" declaration. A decision
# record is a small top-level document, so the status is not scoped to a
# section the way a Story declaration is.
praxisbound_read_decision_status() {
  praxisbound_status_file=$1
  praxisbound_decision_status=
  praxisbound_decision_status_count=0
  praxisbound_fence_length=0

  while IFS= read -r praxisbound_status_line ||
    [ -n "$praxisbound_status_line" ]; do
    praxisbound_trim "$praxisbound_status_line"
    praxisbound_status_line=$praxisbound_trimmed

    praxisbound_update_fence "$praxisbound_status_line"
    [ "$praxisbound_fence_changed" -eq 0 ] || continue
    [ "$praxisbound_fence_length" -eq 0 ] || continue

    case "$praxisbound_status_line" in
      '- '*) praxisbound_status_line="* ${praxisbound_status_line#'- '}" ;;
    esac

    case "$praxisbound_status_line" in
      '* Status: '*)
        praxisbound_decision_status_count=$((praxisbound_decision_status_count + 1))
        praxisbound_decision_status=${praxisbound_status_line#'* Status: '}
        praxisbound_trim "$praxisbound_decision_status"
        praxisbound_decision_status=$praxisbound_trimmed
        ;;
    esac
  done <"$praxisbound_status_file"
}

# Resolves one referenced decision record next to the Story collection, so a
# Story cannot depend on an architecture decision that does not exist or is no
# longer usable. This is the cheapest useful architecture check, not a semantic
# architecture engine.
praxisbound_check_decision() {
  praxisbound_decision_id=$1

  case "$praxisbound_decision_id" in
    ADR-*)
      case "${praxisbound_decision_id#ADR-}" in
        ''|*[!0-9]*)
          praxisbound_story_fail "architecture decision must be ADR-<digits>: $praxisbound_decision_id"
          return
          ;;
      esac
      ;;
    *)
      praxisbound_story_fail "architecture decision must be ADR-<digits>: $praxisbound_decision_id"
      return
      ;;
  esac

  praxisbound_decision_file=
  praxisbound_decision_matches=0

  for praxisbound_decision_candidate in \
    "$praxisbound_decisions_root/$praxisbound_decision_id.md" \
    "$praxisbound_decisions_root/$praxisbound_decision_id"-*.md
  do
    [ -f "$praxisbound_decision_candidate" ] || continue
    if [ -L "$praxisbound_decision_candidate" ]; then
      continue
    fi
    praxisbound_decision_matches=$((praxisbound_decision_matches + 1))
    praxisbound_decision_file=$praxisbound_decision_candidate
  done

  if [ "$praxisbound_decision_matches" -eq 0 ]; then
    praxisbound_story_fail "referenced decision record does not exist: $praxisbound_decision_id"
    return
  fi

  if [ "$praxisbound_decision_matches" -gt 1 ]; then
    praxisbound_story_fail "referenced decision resolves to more than one record: $praxisbound_decision_id"
    return
  fi

  if [ ! -r "$praxisbound_decision_file" ] || [ ! -s "$praxisbound_decision_file" ]; then
    praxisbound_story_fail "referenced decision record is unreadable: $praxisbound_decision_id"
    return
  fi

  praxisbound_read_decision_status "$praxisbound_decision_file"

  if [ "$praxisbound_decision_status_count" -ne 1 ]; then
    praxisbound_story_fail "referenced decision must declare Status exactly once: $praxisbound_decision_id"
    return
  fi

  case "$praxisbound_decision_status" in
    accepted) return ;;
    proposed)
      case "$praxisbound_task_mode" in
        architecture|mixed) return ;;
      esac
      praxisbound_story_fail "referenced decision is still proposed: $praxisbound_decision_id"
      return
      ;;
    superseded|rejected)
      praxisbound_story_fail "referenced decision is not usable ($praxisbound_decision_status): $praxisbound_decision_id"
      return
      ;;
    *)
      praxisbound_story_fail "referenced decision declares an unknown status: $praxisbound_decision_id"
      return
      ;;
  esac
}

praxisbound_check_governance() {
  praxisbound_task_mode=execution
  praxisbound_task_mode_count=0
  praxisbound_authority_seen=
  praxisbound_impact=low
  praxisbound_impact_count=0
  praxisbound_decisions=' '
  praxisbound_decision_count=0
  praxisbound_boundaries=$praxisbound_unit_separator
  praxisbound_boundary_count=0
  praxisbound_contract_count=0
  praxisbound_owners=
  praxisbound_owner_count=0
  praxisbound_risk_level=low
  praxisbound_risk_level_count=0
  praxisbound_reasons=
  praxisbound_reason_count=0
  praxisbound_risk_signals=' '
  praxisbound_scope=full
  praxisbound_scope_count=0
  praxisbound_surface=
  praxisbound_surface_count=0
  praxisbound_scope_seen=' '
  praxisbound_scope_layers='lint static unit integration contract e2e architecture documentation'

  praxisbound_scan_section "$praxisbound_story_file" '## Classification' \
    praxisbound_task_mode_bullet

  if [ "$praxisbound_task_mode_count" -gt 1 ]; then
    praxisbound_story_fail 'Classification must declare "Task mode" at most once'
    praxisbound_task_mode=execution
  elif [ "$praxisbound_task_mode_count" -eq 1 ]; then
    case "$praxisbound_task_mode" in
      architecture|execution|evidence|mixed) ;;
      *)
        praxisbound_story_fail 'Task mode must be architecture, execution, evidence, or mixed'
        praxisbound_task_mode=execution
        ;;
    esac
  fi

  praxisbound_authority_plan=yes
  praxisbound_authority_add_dependency=no
  praxisbound_authority_migration=no
  praxisbound_authority_commit=no
  praxisbound_authority_push=no
  praxisbound_authority_deploy=no
  case "$praxisbound_task_mode" in
    execution|mixed) praxisbound_authority_modify=yes ;;
    *) praxisbound_authority_modify=no ;;
  esac

  praxisbound_scan_section "$praxisbound_story_file" '## Authority' \
    praxisbound_authority_bullet

  if [ "$praxisbound_section_count" -gt 1 ]; then
    praxisbound_story_fail 'Story must declare ## Authority at most once'
  fi

  # An agent being able to perform an operation is not authorization to perform
  # it, and one grant never implies the next one along the chain.
  if [ "$praxisbound_authority_deploy" = yes ] &&
    [ "$praxisbound_authority_push" != yes ]; then
    praxisbound_story_fail 'authority grants deploy without push'
  fi

  if [ "$praxisbound_authority_push" = yes ] &&
    [ "$praxisbound_authority_commit" != yes ]; then
    praxisbound_story_fail 'authority grants push without commit'
  fi

  if [ "$praxisbound_authority_commit" = yes ] &&
    [ "$praxisbound_authority_modify" != yes ]; then
    praxisbound_story_fail 'authority grants commit without modify'
  fi

  if [ "$praxisbound_task_mode" = evidence ]; then
    for praxisbound_mutating_operation in \
      modify add_dependency migration commit push deploy
    do
      eval "praxisbound_mutating_value=\$praxisbound_authority_$praxisbound_mutating_operation"
      if [ "$praxisbound_mutating_value" = yes ]; then
        praxisbound_story_fail "evidence task mode must not authorize $praxisbound_mutating_operation"
      fi
    done
  fi

  praxisbound_scan_section "$praxisbound_story_file" '## Architecture' \
    praxisbound_architecture_bullet
  praxisbound_architecture_sections=$praxisbound_section_count

  if [ "$praxisbound_architecture_sections" -gt 1 ]; then
    praxisbound_story_fail 'Story must declare ## Architecture at most once'
  fi

  if [ "$praxisbound_impact_count" -gt 1 ]; then
    praxisbound_story_fail 'Architecture must declare "Impact" at most once'
    praxisbound_impact=low
  elif [ "$praxisbound_impact_count" -eq 1 ]; then
    case "$praxisbound_impact" in
      low|medium|high) ;;
      *)
        praxisbound_story_fail 'Architecture impact must be low, medium, or high'
        praxisbound_impact=low
        ;;
    esac
  fi

  case "$praxisbound_impact" in
    medium|high)
      if [ "$praxisbound_decision_count" -eq 0 ] &&
        [ "$praxisbound_contract_count" -eq 0 ]; then
        praxisbound_story_fail "architecture impact $praxisbound_impact must name at least one decision or contract"
      fi
      ;;
  esac

  for praxisbound_referenced_decision in $praxisbound_decisions
  do
    praxisbound_check_decision "$praxisbound_referenced_decision"
  done

  praxisbound_owner_rest=$praxisbound_owners
  while [ -n "$praxisbound_owner_rest" ]; do
    praxisbound_owner_entry=${praxisbound_owner_rest%%"$praxisbound_unit_separator"*}
    praxisbound_owner_rest=${praxisbound_owner_rest#*"$praxisbound_unit_separator"}

    case "$praxisbound_owner_entry" in
      *' = '*) ;;
      *)
        praxisbound_story_fail "architecture owner must be stated as <boundary> = <owner>: $praxisbound_owner_entry"
        continue
        ;;
    esac

    praxisbound_owned_boundary=${praxisbound_owner_entry%%' = '*}
    praxisbound_owning_domain=${praxisbound_owner_entry#*' = '}

    if [ -z "$praxisbound_owning_domain" ]; then
      praxisbound_story_fail "architecture owner names no owning domain: $praxisbound_owner_entry"
      continue
    fi

    case "$praxisbound_boundaries$praxisbound_unit_separator" in
      *"$praxisbound_unit_separator$praxisbound_owned_boundary$praxisbound_unit_separator"*) ;;
      *)
        praxisbound_story_fail "architecture owner names an undeclared boundary: $praxisbound_owned_boundary"
        ;;
    esac
  done

  praxisbound_scan_section "$praxisbound_story_file" '## Risk' praxisbound_risk_bullet

  if [ "$praxisbound_section_count" -gt 1 ]; then
    praxisbound_story_fail 'Story must declare ## Risk at most once'
  fi

  if [ "$praxisbound_risk_level_count" -gt 1 ]; then
    praxisbound_story_fail 'Risk must declare "Level" at most once'
    praxisbound_risk_level=low
  elif [ "$praxisbound_risk_level_count" -eq 1 ]; then
    case "$praxisbound_risk_level" in
      low|medium|high) ;;
      *)
        praxisbound_story_fail 'Risk level must be low, medium, or high'
        praxisbound_risk_level=low
        ;;
    esac
  fi

  case "$praxisbound_risk_level" in
    medium|high)
      [ "$praxisbound_reason_count" -gt 0 ] ||
        praxisbound_story_fail "risk level $praxisbound_risk_level must name at least one reason"
      ;;
  esac

  # Risk raises inspection and verification depth; it never widens scope. A
  # recognized high-risk signal may therefore not be filed as lower risk.
  if [ "$praxisbound_risk_level" != high ]; then
    for praxisbound_declared_reason in $praxisbound_reasons
    do
      case " $praxisbound_high_risk_signals " in
        *" $praxisbound_declared_reason "*)
          praxisbound_story_fail "risk reason $praxisbound_declared_reason is a high-risk signal but the level is $praxisbound_risk_level"
          ;;
      esac
    done
  fi

  praxisbound_check_risk_contracts

  praxisbound_scan_section "$praxisbound_story_file" '## Verification Scope' \
    praxisbound_scope_bullet
  if [ "$praxisbound_section_count" -gt 1 ] ||
    { [ "$praxisbound_section_count" -eq 1 ] && [ "$praxisbound_scope_count" -ne 1 ]; }; then
    praxisbound_story_fail 'Story must declare one Scope in at most one ## Verification Scope section'
  fi
  if [ "$praxisbound_scope_count" -gt 1 ]; then
    praxisbound_story_fail 'verification Scope is declared more than once'
  fi
  if [ "$praxisbound_surface_count" -gt 1 ]; then
    praxisbound_story_fail 'verification Surface is declared more than once'
  fi

  case "$praxisbound_scope" in
    full)
      if [ "$praxisbound_surface_count" -ne 0 ] || [ "$praxisbound_scope_seen" != ' ' ]; then
        praxisbound_story_fail 'full verification scope must not declare Surface or focused commands'
      fi
      ;;
    focused)
      if [ "$praxisbound_surface_count" -ne 1 ]; then
        praxisbound_story_fail 'focused verification scope must declare one Surface'
      fi
      case "$praxisbound_surface" in
        executable)
          case "$praxisbound_risk_level" in
            low) praxisbound_scope_required='lint static unit' ;;
            medium) praxisbound_scope_required='lint static unit integration' ;;
            high) praxisbound_scope_required='lint static unit integration contract e2e' ;;
          esac
          case "$praxisbound_impact" in
            medium|high) praxisbound_scope_required="$praxisbound_scope_required architecture" ;;
          esac
          ;;
        documentation)
          if [ "$praxisbound_risk_level" != low ] || [ "$praxisbound_impact" != low ]; then
            praxisbound_story_fail 'focused documentation requires low risk and low architecture impact'
          fi
          praxisbound_scope_required=documentation
          ;;
        *)
          praxisbound_story_fail 'focused verification Surface must be executable or documentation'
          praxisbound_scope_required=
          ;;
      esac
      for praxisbound_scope_check in $praxisbound_scope_required; do
        case " $praxisbound_scope_seen " in
          *" $praxisbound_scope_check "*) ;;
          *) praxisbound_story_fail "focused verification check is not declared: $praxisbound_scope_check" ;;
        esac
      done
      for praxisbound_scope_check in $praxisbound_scope_seen; do
        case " $praxisbound_scope_required " in
          *" $praxisbound_scope_check "*) ;;
          *) praxisbound_story_fail "focused verification declares an unrequired check: $praxisbound_scope_check" ;;
        esac
      done
      ;;
    *) praxisbound_story_fail 'verification Scope must be full or focused' ;;
  esac
}

# One Story ID grammar, shared with scripts/handoff-check: hyphen-separated
# segments of uppercase letters and digits, where the first segment starts with
# an uppercase letter, each middle segment has an uppercase letter, and the last
# segment is digits. DBCLI-PLAT-001 conforms; FF-1-2 does not. Stated in
# protocol/story.md and protocol/handoff.md.
praxisbound_is_story_id() {
  case "$1" in
    *-*) ;;
    *) return 1 ;;
  esac

  praxisbound_id_first=${1%%-*}
  praxisbound_id_last=${1##*-}
  praxisbound_id_rest=${1#*-}

  case "$praxisbound_id_first" in
    ["$praxisbound_upper"]) ;;
    ["$praxisbound_upper"]*)
      case "$praxisbound_id_first" in
        *[!"$praxisbound_upper$praxisbound_digit"]*) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac

  case "$praxisbound_id_last" in
    '') return 1 ;;
    *[!"$praxisbound_digit"]*) return 1 ;;
  esac

  while [ "$praxisbound_id_rest" != "$praxisbound_id_last" ]
  do
    praxisbound_id_middle=${praxisbound_id_rest%%-*}

    case "$praxisbound_id_middle" in
      *[!"$praxisbound_upper$praxisbound_digit"]*) return 1 ;;
      *["$praxisbound_upper"]*) ;;
      *) return 1 ;;
    esac

    praxisbound_id_rest=${praxisbound_id_rest#*-}
  done

  return 0
}

# A Story directory is a Story ID followed by an optional readable slug. The ID
# is the shortest leading run of segments that is itself a valid Story ID, so
# FF-227-story-id-grammar names FF-227 and FF-232-API-limits names FF-232. A
# slug is never absorbed into the ID, because the ID stops as soon as it is
# complete.
praxisbound_check_story_id() {
  praxisbound_story_name=$1

  while :; do
    case "$praxisbound_story_name" in
      */) praxisbound_story_name=${praxisbound_story_name%/} ;;
      *) break ;;
    esac
  done

  praxisbound_story_name=${praxisbound_story_name##*/}

  praxisbound_story_id=
  praxisbound_name_rest=$praxisbound_story_name
  praxisbound_name_prefix=
  praxisbound_name_started=0

  while :; do
    praxisbound_name_segment=${praxisbound_name_rest%%-*}

    if [ "$praxisbound_name_started" -eq 0 ]; then
      praxisbound_name_prefix=$praxisbound_name_segment
      praxisbound_name_started=1
    else
      praxisbound_name_prefix="$praxisbound_name_prefix-$praxisbound_name_segment"
    fi

    if praxisbound_is_story_id "$praxisbound_name_prefix"; then
      praxisbound_story_id=$praxisbound_name_prefix
      break
    fi

    case "$praxisbound_name_rest" in
      *-*) praxisbound_name_rest=${praxisbound_name_rest#*-} ;;
      *) break ;;
    esac
  done

  if [ -z "$praxisbound_story_id" ]; then
    praxisbound_story_fail "Story directory does not name a Story ID: $praxisbound_story_name (no leading run of its hyphen-separated segments is one; a Story ID is segments of uppercase letters and digits, where the first segment starts with an uppercase letter, each middle segment has an uppercase letter, and the last segment is digits)"
    return
  fi

  praxisbound_report 'INFO' "Story ID $praxisbound_story_id"
}

praxisbound_check_story() {
  praxisbound_story_directory=$1
  praxisbound_story_label=$praxisbound_story_directory

  praxisbound_story_file="$praxisbound_story_directory/story.md"
  praxisbound_acceptance_file="$praxisbound_story_directory/acceptance.md"

  for praxisbound_required_story_file in \
    "$praxisbound_story_file" "$praxisbound_acceptance_file"
  do
    if [ -L "$praxisbound_required_story_file" ]; then
      printf 'ERROR %s: required Story file is a symlink: %s\n' \
        "$praxisbound_story_label" "$praxisbound_required_story_file" >&2
      praxisbound_operational_error=1
      return
    fi

    if [ ! -f "$praxisbound_required_story_file" ] ||
      [ ! -r "$praxisbound_required_story_file" ] ||
      [ ! -s "$praxisbound_required_story_file" ]; then
      printf 'ERROR %s: required Story file is missing or unreadable: %s\n' \
        "$praxisbound_story_label" "$praxisbound_required_story_file" >&2
      praxisbound_operational_error=1
      return
    fi
  done

  praxisbound_check_story_id "$praxisbound_story_directory"

  if [ "$praxisbound_ready" -eq 1 ]; then
    praxisbound_check_readiness
  fi

  if [ -n "${FORGEFLOW_DECISIONS_ROOT:-}" ]; then
    praxisbound_story_fail 'FORGEFLOW_DECISIONS_ROOT is retired; use PRAXISBOUND_DECISIONS_ROOT'
    praxisbound_decisions_root="$praxisbound_story_directory/../../decisions"
  elif [ -n "${PRAXISBOUND_DECISIONS_ROOT:-}" ]; then
    praxisbound_decisions_root=$PRAXISBOUND_DECISIONS_ROOT
  else
    praxisbound_decisions_root="$praxisbound_story_directory/../../decisions"
  fi
  praxisbound_check_governance

  praxisbound_read_declaration \
    "$praxisbound_story_file" '## Classification' 'Security sensitive'
  praxisbound_security_count=$praxisbound_declaration_count
  praxisbound_security=$praxisbound_declaration_value

  praxisbound_read_declaration \
    "$praxisbound_story_file" '## Classification' 'Baseline conformance'
  praxisbound_baseline_count=$praxisbound_declaration_count
  praxisbound_baseline=$praxisbound_declaration_value

  praxisbound_classification_valid=1

  if [ "$praxisbound_security_count" -ne 1 ]; then
    praxisbound_story_fail 'Classification must declare "Security sensitive" exactly once'
    praxisbound_classification_valid=0
  else
    case "$praxisbound_security" in
      yes|no) ;;
      *)
        praxisbound_story_fail 'Security sensitive must be declared as yes or no'
        praxisbound_classification_valid=0
        ;;
    esac
  fi

  if [ "$praxisbound_baseline_count" -ne 1 ]; then
    praxisbound_story_fail 'Classification must declare "Baseline conformance" exactly once'
    praxisbound_classification_valid=0
  else
    case "$praxisbound_baseline" in
      yes|no) ;;
      *)
        praxisbound_story_fail 'Baseline conformance must be declared as yes or no'
        praxisbound_classification_valid=0
        ;;
    esac
  fi

  if [ "$praxisbound_classification_valid" -eq 0 ]; then
    return
  fi

  praxisbound_check_matrix "$praxisbound_acceptance_file"

  praxisbound_count_literal_bullets \
    "$praxisbound_story_file" '## Trust Boundary Fields'
  praxisbound_trust_found=$praxisbound_bullet_section_found
  praxisbound_trust_total=$praxisbound_bullet_total
  praxisbound_trust_literal=$praxisbound_bullet_literal

  praxisbound_count_literal_bullets \
    "$praxisbound_story_file" '## Superseded Behavior'
  praxisbound_superseded_found=$praxisbound_bullet_section_found
  praxisbound_superseded_total=$praxisbound_bullet_total
  praxisbound_superseded_literal=$praxisbound_bullet_literal

  if [ "$praxisbound_security" = 'yes' ]; then
    if [ "$praxisbound_matrix_found" -eq 0 ]; then
      praxisbound_story_fail 'security-sensitive Story is missing acceptance section: ## Security Fixture Matrix'
    elif [ "$praxisbound_matrix_rows" -eq 0 ]; then
      praxisbound_story_fail 'security fixture matrix declares no fixture rows'
    fi

    if [ "$praxisbound_trust_found" -eq 0 ] ||
      [ "$praxisbound_trust_total" -eq 0 ]; then
      praxisbound_story_fail 'security-sensitive Story must enumerate its trust-boundary fields under ## Trust Boundary Fields'
    elif [ "$praxisbound_trust_literal" -ne "$praxisbound_trust_total" ]; then
      praxisbound_story_fail 'every trust-boundary field must name an exact field, not prose'
    fi
  elif [ "$praxisbound_matrix_found" -eq 1 ]; then
    praxisbound_story_fail 'Story declares Security sensitive: no but provides a security fixture matrix'
  fi

  if [ "$praxisbound_baseline" = 'yes' ]; then
    if [ "$praxisbound_superseded_found" -eq 0 ] ||
      [ "$praxisbound_superseded_total" -eq 0 ]; then
      praxisbound_story_fail 'baseline-conformance Story must list superseded tests or behavior under ## Superseded Behavior'
    elif [ "$praxisbound_superseded_literal" -ne \
      "$praxisbound_superseded_total" ]; then
      praxisbound_story_fail 'every superseded entry must name an exact test path or behavior'
    fi
  elif [ "$praxisbound_superseded_found" -eq 1 ]; then
    praxisbound_story_fail 'Story declares Baseline conformance: no but declares superseded behavior'
  fi

  if [ "$praxisbound_contract_incomplete" -eq "$praxisbound_entry_incomplete" ]; then
    praxisbound_report 'PASS' \
      "classification security=$praxisbound_security baseline=$praxisbound_baseline"
  fi
}

praxisbound_upper='ABCDEFGHIJKLMNOPQRSTUVWXYZ'
praxisbound_digit='0123456789'
praxisbound_cr=$(printf '\r')
praxisbound_tab=$(printf '\t')
praxisbound_unit_separator=$(printf '\036')
praxisbound_authority_keys='plan modify add_dependency migration commit push deploy'
praxisbound_high_risk_signals='authentication authorization security payment payments schema-migration data-loss public-contract concurrency production-config dependency-supply-chain destructive-operation'
praxisbound_standard_risk_signals='error-projection concurrency bounded-capacity retention-overflow'
praxisbound_matrix_header_row='| Source field | Payload | Expected result | Persisted locations | Verification |'
praxisbound_evidence_header_row='| AC | Method | Evidence | Fixture / precondition | Expected observation |'
praxisbound_ready=0
if [ "${1-}" = --ready ]; then
  praxisbound_ready=1
  shift
fi

case "${1-}" in
  --help)
    if [ "$#" -ne 1 ] || [ "$praxisbound_ready" -eq 1 ]; then
      usage_error
      exit 2
    fi
    help
    exit 0
    ;;
  -*)
    usage_error
    exit 2
    ;;
esac

praxisbound_contract_incomplete=0
praxisbound_readiness_incomplete=0
praxisbound_operational_error=0
praxisbound_checked=0

printf 'PraxisBound Story Contract Check\n\n'

if [ "$#" -eq 0 ]; then
  if [ ! -d specs/stories ]; then
    printf 'ERROR Story directory is missing: specs/stories/\n' >&2
    printf '\nResult: ERROR\n'
    printf 'Stories checked: 0\n'
    exit 2
  fi

  for praxisbound_candidate in specs/stories/*
  do
    [ -d "$praxisbound_candidate" ] || continue

    case "$praxisbound_candidate" in
      */_template) continue ;;
    esac

    praxisbound_entry_incomplete=$praxisbound_contract_incomplete
    praxisbound_checked=$((praxisbound_checked + 1))
    praxisbound_check_story "$praxisbound_candidate"
  done
else
  for praxisbound_candidate in "$@"
  do
    case "$praxisbound_candidate" in
      -*) usage_error; exit 2 ;;
    esac
    if [ ! -d "$praxisbound_candidate" ]; then
      printf 'ERROR Story directory is missing: %s\n' \
        "$praxisbound_candidate" >&2
      praxisbound_operational_error=1
      continue
    fi

    praxisbound_entry_incomplete=$praxisbound_contract_incomplete
    praxisbound_checked=$((praxisbound_checked + 1))
    praxisbound_check_story "$praxisbound_candidate"
  done
fi

printf '\n'

if [ "$praxisbound_operational_error" -eq 1 ]; then
  printf 'Result: ERROR\n'
  printf 'Stories checked: %s\n' "$praxisbound_checked"
  exit 2
fi

if [ "$praxisbound_checked" -eq 0 ]; then
  printf 'ERROR No Story directory was checked\n' >&2
  printf 'Result: ERROR\n'
  printf 'Stories checked: 0\n'
  exit 2
fi

if [ "$praxisbound_ready" -eq 1 ]; then
  if [ "$praxisbound_contract_incomplete" -gt 0 ]; then
    printf 'Structure: STORY_CONTRACT_INCOMPLETE\n'
  else
    printf 'Structure: STORY_CONTRACT_OK\n'
  fi
  if [ "$praxisbound_contract_incomplete" -gt 0 ] ||
    [ "$praxisbound_readiness_incomplete" -gt 0 ]; then
    printf 'Result: STORY_READINESS_INCOMPLETE\n'
    printf 'Stories checked: %s\n' "$praxisbound_checked"
    printf 'Fill the reported structure or minimum content, then recheck.\n'
    exit 1
  fi
  printf 'Result: STORY_READINESS_OK\n'
  printf 'Stories checked: %s\n' "$praxisbound_checked"
  printf 'Minimum content only, not human-approved READY. Run make verify and human review.\n'
  exit 0
fi

if [ "$praxisbound_contract_incomplete" -gt 0 ]; then
  printf 'Result: STORY_CONTRACT_INCOMPLETE\n'
  printf 'Stories checked: %s\n\n' "$praxisbound_checked"
  printf 'Next:\n'
  printf 'Record the missing classification, conditional contract, fixture\n'
  printf 'matrix, or superseded behavior in the Story, then recheck.\n'
  exit 1
fi

printf 'Result: STORY_CONTRACT_OK\n'
printf 'Stories checked: %s\n\n' "$praxisbound_checked"
printf 'Next:\n'
printf 'Static Story structure only. Run make verify and human review.\n'
