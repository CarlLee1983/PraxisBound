#!/bin/sh

set -eu

if [ "$#" -ne 0 ]; then
  printf 'release check failed: release-check takes no arguments\n' >&2
  exit 2
fi

case ${RELEASE_CHECK_IMPLEMENTATION:-typescript} in
  typescript) ;;
  *)
    printf 'release check failed: unsupported implementation\n' >&2
    exit 2
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  printf 'release check failed: NODE_UNAVAILABLE\n' >&2
  exit 1
fi

release_root=$(CDPATH='' cd -P "$(dirname "$0")/.." >/dev/null 2>&1 && pwd)
exec node "$release_root/scripts/release-check-compat.mjs"
