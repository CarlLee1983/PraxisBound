{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:manifest:1",
  "title": "PraxisBound Batch Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "sources", "requirements", "dependencies"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId" },
    "title": { "type": "string", "maxLength": 256 },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adrs", "specs", "stories"],
      "properties": {
        "adrs": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/repoPath" } },
        "specs": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/repoPath" } },
        "stories": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/repoPath" } }
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec", "anchor", "stories"],
        "properties": {
          "spec": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/repoPath" },
          "anchor": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "stories": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId" } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story", "dependsOn"],
        "properties": {
          "story": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId" },
          "dependsOn": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId" } }
        }
      }
    }
  }
}
