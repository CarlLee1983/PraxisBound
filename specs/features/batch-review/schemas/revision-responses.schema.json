{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:revision-responses:1",
  "title": "PraxisBound Revision Response record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "fromFingerprint",
    "toFingerprint",
    "revisionSheets",
    "respondedAt",
    "agent",
    "responses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "batchId": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId"
    },
    "fromFingerprint": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
    },
    "toFingerprint": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
    },
    "respondedAt": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime"
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "responses": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revisionId",
          "route",
          "outcome",
          "rationale",
          "locators"
        ],
        "properties": {
          "revisionId": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/revisionId"
          },
          "route": {
            "enum": [
              "presentation",
              "story-derivation",
              "spec-requirement",
              "decision"
            ]
          },
          "outcome": {
            "enum": [
              "incorporated",
              "needs-decision",
              "not-incorporated"
            ]
          },
          "rationale": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/nonEmptyText"
          },
          "question": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/nonEmptyText"
          },
          "locators": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/locator"
            }
          },
          "blockingSuggestion": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "needs-decision"
                }
              }
            },
            "then": {
              "required": [
                "question"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "incorporated"
                }
              }
            },
            "then": {
              "properties": {
                "locators": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "revisionSheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
      }
    }
  }
}
