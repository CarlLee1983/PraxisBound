{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:revision-sheet:1",
  "title": "PraxisBound Revision Request sheet v1 (the praxisbound-revisions JSON block)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "fingerprint",
    "exportedAt",
    "revisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "batchId": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId"
    },
    "fingerprint": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
    },
    "exportedAt": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime"
    },
    "revisions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fingerprint",
          "targets",
          "quote",
          "kind",
          "blocking",
          "proposal",
          "rationale",
          "createdAt"
        ],
        "properties": {
          "id": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/revisionId"
          },
          "fingerprint": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/locator"
            }
          },
          "quote": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/text"
          },
          "kind": {
            "enum": [
              "supplement",
              "rewrite",
              "add-requirement",
              "delete"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "proposal": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/text"
          },
          "rationale": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/text"
          },
          "createdAt": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime"
          },
          "supersedes": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/revisionId"
          }
        }
      }
    }
  }
}
