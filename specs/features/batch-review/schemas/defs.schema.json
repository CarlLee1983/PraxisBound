{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:defs:1",
  "title": "PraxisBound batch review shared definitions v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batchId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]+(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$",
      "maxLength": 128
    },
    "storyId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]+$",
      "maxLength": 64
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\\\\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "utcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^REV-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor",
        "blockSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "blockSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "recordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewOutcome": {
      "enum": [
        "REVIEW_READY",
        "REVIEW_BLOCKED",
        "REVIEW_INCOMPLETE",
        "REVIEW_STALE"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
        },
        "severity": {
          "enum": [
            "blocking",
            "advisory"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]+$"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    }
  }
}
