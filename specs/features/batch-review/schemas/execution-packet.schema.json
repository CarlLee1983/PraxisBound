{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:execution-packet:1",
  "title": "PraxisBound Execution Packet v1",
  "description": "Start-of-work input. Not a protocol handoff, not verification Evidence, and never a grant of authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "fingerprint",
    "revision",
    "confirmation",
    "preflight",
    "semanticReportSha256",
    "stories",
    "goalId",
    "authorization",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "batchId": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId"
    },
    "fingerprint": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "confirmation": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/recordRef"
    },
    "preflight": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/recordRef"
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId"
          },
          "path": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/repoPath"
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId"
            }
          }
        }
      }
    },
    "goalId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-[0-9]+(?:-[a-z0-9]+)*-[a-f0-9]{12}(?:-a[1-9][0-9]*)?$",
      "maxLength": 256
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedSource",
        "reference"
      ],
      "properties": {
        "observedSource": {
          "enum": [
            "story",
            "session",
            "control-plane",
            "none"
          ]
        },
        "reference": {
          "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/text"
        }
      }
    },
    "generatedAt": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime"
    },
    "semanticReportSha256": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    }
  }
}
