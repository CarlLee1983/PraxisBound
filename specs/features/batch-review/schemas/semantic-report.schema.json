{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:semantic-report:1",
  "title": "PraxisBound batch review Semantic Report v1",
  "description": "Agent observations. Coverage of every Story and category is checked mechanically; semantic correctness is not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "fingerprint", "agent", "observedAt", "stories"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "batchId": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId" },
    "fingerprint": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256" },
    "agent": { "type": "string", "minLength": 1, "maxLength": 256 },
    "observedAt": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime" },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story", "categories"],
        "properties": {
          "story": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId" },
          "categories": {
            "type": "object",
            "additionalProperties": false,
            "required": ["missing-split", "contradiction", "insufficient-acceptance", "open-question"],
            "properties": {
              "missing-split": { "$ref": "#/$defs/conclusion" },
              "contradiction": { "$ref": "#/$defs/conclusion" },
              "insufficient-acceptance": { "$ref": "#/$defs/conclusion" },
              "open-question": { "$ref": "#/$defs/conclusion" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "conclusion": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["result"], "properties": { "result": { "const": "none" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "issues"],
          "properties": {
            "result": { "const": "issues" },
            "issues": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["locator", "observation", "impact", "blocking", "suggestion"],
                "properties": {
                  "locator": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/locator" },
                  "observation": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/nonEmptyText" },
                  "impact": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/nonEmptyText" },
                  "blocking": { "type": "boolean" },
                  "suggestion": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/text" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
