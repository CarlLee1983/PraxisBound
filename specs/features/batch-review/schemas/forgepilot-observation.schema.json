{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:forgepilot-observation:2",
  "title": "PraxisBound external integration observation v2 (ForgePilot)",
  "description": "What one handoff session observed through ForgePilot's public CLI, written through `review observe`. ForgePilot remains authoritative for current state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "fingerprint",
    "goalPlan",
    "forgepilotVersion",
    "observedAt",
    "steps",
    "stoppedBecause"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "batchId": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId"
    },
    "fingerprint": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256"
    },
    "goalPlan": {
      "description": "The Goal Plan Manifest this session handed off.",
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/recordRef"
    },
    "goalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "forgepilotVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "The exact ForgePilot commit the executable was built from."
    },
    "observedAt": {
      "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime"
    },
    "steps": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit",
          "stdout",
          "stderr"
        ],
        "properties": {
          "command": {
            "enum": [
              "preflight",
              "work-list",
              "goal-create",
              "work-add",
              "goal-preflight",
              "execution-plan",
              "run-dry-run",
              "run"
            ]
          },
          "story": {
            "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/storyId"
          },
          "workItemId": {
            "type": "string",
            "pattern": "^WI-[0-9]+$"
          },
          "created": {
            "type": "boolean",
            "description": "`work add --json` `created`; false means ForgePilot returned an existing Work Item for the same external reference."
          },
          "exit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "null only when the process could not be started or its exit was not observed."
          },
          "stdout": {
            "type": "string",
            "maxLength": 1048576
          },
          "stderr": {
            "type": "string",
            "maxLength": 1048576
          },
          "truncated": {
            "type": "boolean"
          },
          "originalStdoutBytes": {
            "type": "integer",
            "minimum": 0
          },
          "originalStderrBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "stoppedBecause": {
      "enum": [
        "awaiting-authorization",
        "goal-completed",
        "run-needs-human",
        "run-limit-reached",
        "run-interrupted",
        "run-failed",
        "authorization-missing",
        "preflight-not-ready",
        "goal-mismatch",
        "work-mismatch",
        "goal-preflight-failed",
        "execution-plan-failed",
        "step-failed",
        "result-unknown"
      ]
    }
  }
}
