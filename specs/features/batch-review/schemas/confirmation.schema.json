{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxisbound:batch-review:confirmation:1",
  "title": "PraxisBound Definition Confirmation record v1",
  "description": "A recorded claim of an explicit terminal act. Not identity-verified and not Execution Authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "claim", "batchId", "fingerprint", "manifestSha256", "sources", "confirmedAt", "deferred", "revisionSheets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "claim": { "const": "explicit-terminal-confirmation" },
    "batchId": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/batchId" },
    "fingerprint": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256" },
    "manifestSha256": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256" },
    "sources": { "type": "array", "minItems": 1, "maxItems": 5000, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sourceDigest" } },
    "confirmedAt": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/utcTime" },
    "deferred": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revisionId", "reason"],
        "properties": {
          "revisionId": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/revisionId" },
          "reason": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/nonEmptyText" }
        }
      }
    },
    "revisionSheets": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "urn:praxisbound:batch-review:defs:1#/$defs/sha256" } }
  }
}
