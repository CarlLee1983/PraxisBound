{
  "name": "@praxisbound/cli",
  "version": "0.3.0",
  "description": "PraxisBound CLI and machine-result serialization",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlLee1983/PraxisBound.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "praxisbound": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc --build && node ./scripts/copy-snapshot.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@praxisbound/core": "0.3.0"
  }
}
